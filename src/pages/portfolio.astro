---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { projects } from '../data/projects';
---

<Base title="Portfolio - Rodney Cumming" description="Personal projects Rodney Cumming has designed and built over the years.">
  <PageHeader
    heading="PORTFOLIO"
    body="Here are some personal projects I have created over the years."
    button={{ label: 'GITHUB', href: 'https://github.com/RodneyCumming' }}
    background="var(--mirage)"
    buttonColour="var(--calypso)"
    buttonHover="var(--curious-blue)"
  />
  <div class="grid">
    {projects.map((p, i) => <ProjectTile project={p} index={i} />)}
  </div>
</Base>

<style>
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
