<!--
  The fox mascot. He sits in the hero foothills; as you scroll he runs down
  the slope, along the ground at the foot of the mountains, then leaps down
  onto the ABOUT ME heading and sits. The run cycle is a sprite sheet
  (sit, twelve gallop frames, crouch, leap, land) and the frame advances with the distance he
  covers, so his legs keep pace with his speed. A small script is needed
  because the path depends on where the hero and heading are at any width.
-->
<div class="fox" aria-hidden="true"><div class="fox__sprite"></div></div>

<script is:inline>
  // Runs after parsing, so the About heading further down exists
  document.addEventListener('DOMContentLoaded', function () {
    var fox = document.querySelector('.fox');
    var sprite = fox && fox.firstElementChild;
    var hero = document.querySelector('.hero');
    var target = document.querySelector('.heading-text');
    if (!fox || !hero || !target) return;

    var W = 80, H = 56; // one frame: 0 sit, 1-12 gallop, 13 crouch, 14 leap, 15 land
    var STRIDE = 9; // px of travel per gallop frame (a full stride is ~108px)
    // Top edge of the front mountain range (mountains-4.svg), in its own
    // units: one height every 20 units across its 3991-unit width. Measured
    // from the artwork so the fox can sit exactly on the ridge line.
    var RIDGE = [88,81,74,67,59,52,45,38,31,23,16,9,11,17,24,31,38,45,51,58,65,69,63,56,61,67,73,80,86,92,98,105,111,117,123,130,136,142,148,140,132,124,115,107,96,85,73,62,50,39,28,16,5,7,18,29,39,50,61,58,52,62,71,81,91,101,111,121,124,119,115,111,107,103,98,94,90,86,81,77,73,69,64,62,66,70,74,78,82,86,90,94,98,102,106,110,114,118,122,126,130,134,131,116,102,87,95,109,119,108,97,86,75,64,53,42,45,55,66,76,79,67,55,43,30,18,7,18,7,18,30,41,47,40,33,38,44,51,57,64,70,77,83,89,96,102,109,115,122,122,115,109,103,96,90,83,77,70,64,58,51,45,44,50,56,62,68,74,80,87,93,99,105,111,117,117,106,95,84,73,62,51,48,59,69,80,80,69,58,51,62,72,83,93,103,114,124,134,145,155];
    var range = document.querySelector('.range--4 img');
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var path, total, s0, s1, lastP = 0, facingRight = false;

    // Path in page coordinates, at paw level. Recomputed on resize.
    // Layout position, ignoring transforms (the heading fades up into place,
    // so its on-screen rect is offset while that runs)
    function layoutRect(el) {
      var x = 0, y = 0, n = el;
      while (n) {
        x += n.offsetLeft;
        y += n.offsetTop;
        n = n.offsetParent;
      }
      return { left: x, top: y, right: x + el.offsetWidth, bottom: y + el.offsetHeight, width: el.offsetWidth };
    }

    function layout() {
      var h = layoutRect(hero), t = layoutRect(target);
      var em = parseFloat(getComputedStyle(target).fontSize);
      var desktop = innerWidth >= 768;
      var ground = h.bottom - (desktop ? 34 : 26);
      var start = ridgeStart(h);
      var foot = { x: h.left + h.width * 0.66, y: ground };
      var land = { x: t.right - W / 2 + 4, y: t.top + em * 0.13 };
      var launch = { x: Math.max(land.x + 70, Math.min(foot.x - 40, land.x + 160)), y: ground };
      if (launch.x > foot.x) launch.x = foot.x;
      path = [start, foot, launch, land];
      total = dist(start, foot) + dist(foot, launch);
      // Run while the hero scrolls away; land as the heading reaches mid-screen
      s0 = 30;
      s1 = Math.max(s0 + 200, t.top - innerHeight * 0.5);
      fox.classList.add('is-ready');
      update();
    }

    // Where the front range's ridge is drawn on the page
    function ridgeBox() {
      var r = layoutRect(range);
      var sc = Math.min(r.width / 3991, range.offsetHeight / 298);
      return { left: r.left + (r.width - 3991 * sc) / 2, top: r.top, sc: sc };
    }

    function ridgeAt(sx) {
      var i = Math.max(0, Math.min(RIDGE.length - 1.001, sx / 20)), j = Math.floor(i);
      return RIDGE[j] + (RIDGE[j + 1] - RIDGE[j]) * (i - j);
    }

    // Sit on the ridge near 80% across, at the most level spot within reach,
    // so he perches on a gentle shoulder of the hill rather than a summit.
    function ridgeStart(h) {
      var b = ridgeBox();
      var want = (h.left + h.width * 0.8 - b.left) / b.sc, best = want, bestSlope = 1e9;
      for (var sx = want - 220; sx <= want + 220; sx += 10) {
        var slope = Math.abs(ridgeAt(sx + 20) - ridgeAt(sx - 20));
        var y = ridgeAt(sx);
        if (y < 40) continue; // skip summits
        if (slope < bestSlope) {
          bestSlope = slope;
          best = sx;
        }
      }
      return { x: b.left + best * b.sc, y: b.top + ridgeAt(best) * b.sc + 2 };
    }

    function dist(a, b) {
      return Math.hypot(b.x - a.x, b.y - a.y);
    }

    function lerp(a, b, k) {
      return { x: a.x + (b.x - a.x) * k, y: a.y + (b.y - a.y) * k };
    }

    function place(pt, frame, flip) {
      fox.style.transform = 'translate3d(' + (pt.x - W / 2) + 'px,' + (pt.y - H) + 'px,0)';
      sprite.style.backgroundPosition = -frame * W + 'px 0';
      sprite.style.transform = flip ? 'scaleX(-1)' : '';
    }

    function update() {
      if (!path) return;
      if (reduce) return place(path[3], 0, false);
      var p = Math.min(1, Math.max(0, (scrollY - s0) / (s1 - s0)));
      if (p !== lastP) facingRight = p < lastP;
      lastP = p;
      var RUN = 0.78; // share of the scroll spent running; the rest is the leap
      if (p <= 0) return place(path[0], 0, false);
      if (p >= 1) return place(path[3], 0, false);
      if (p < RUN) {
        var d = (p / RUN) * total, a = dist(path[0], path[1]);
        var pt = d < a ? lerp(path[0], path[1], d / a) : lerp(path[1], path[2], (d - a) / dist(path[1], path[2]));
        return place(pt, d < 10 ? 13 : 1 + (Math.floor(d / STRIDE) % 12), facingRight);
      }
      // Leap: a parabola from the launch point down onto the heading
      var k = (p - RUN) / (1 - RUN);
      var q = lerp(path[2], path[3], k);
      q.y -= Math.sin(k * Math.PI) * 46;
      place(q, k < 0.12 ? 13 : k > 0.86 ? 15 : 14, facingRight);
    }

    var ticking = false;
    addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        update();
      });
    }, { passive: true });
    addEventListener('resize', layout);
    if (document.fonts) document.fonts.ready.then(layout);
    addEventListener('load', layout);
    layout();
  });
</script>

<style>
  .fox {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: 80px;
    height: 56px;
    pointer-events: none;
    visibility: hidden;
    will-change: transform;
  }

  .fox.is-ready {
    visibility: visible;
  }

  /* During the home intro he waits until the mountains are in, then appears */
  :global(html.intro:not(.intro-go)) .fox {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.intro-go) .fox {
      animation: fox-appear 0.6s ease-out 1.1s both;
    }
  }

  @keyframes fox-appear {
    from {
      opacity: 0;
    }
  }

  .fox__sprite {
    width: 100%;
    height: 100%;
    background: url('/images/fox-sprite.svg') 0 0 / 1280px 56px no-repeat;
  }
</style>
