<!--
  The fox mascot travels the whole home page as you scroll.

  He starts sitting on the front ridge of the hero. Each section has a perch,
  and as you scroll he runs and leaps from one to the next, only ever moving
  along real surfaces: the ground at the foot of the mountains, the tops of
  headings, coffee cups, filter pills and icons, and the edges between
  sections. He rests on each perch (blinking, flicking his tail).

  In Technology he sits on top of the filter bar and every few seconds does a
  backflip (now and then a double).

  In Contact he's curled up asleep on top of the email box. Every so often he
  lifts his head, looks around (ahead, back over his tail, up), blinks and
  goes back to sleep.

  Frames come from public/images/fox-sprite.svg (order listed in
  scripts/fox/fox.py). Running frames advance with the distance he covers, so
  his legs keep pace with his speed; he faces the way he's moving, so he turns
  around when you scroll back up. With reduced motion he simply sits on the
  first heading.
-->
<div class="fox" aria-hidden="true"><div class="fox__shadow"></div><div class="fox__sprite"></div><div class="fox__z"><i>z</i><i>z</i><i>z</i></div></div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var fox = document.querySelector('.fox');
    var sprite = fox && fox.querySelector('.fox__sprite');
    var hero = document.querySelector('.hero');
    var range = document.querySelector('.range--4 img');
    if (!fox || !hero || !range) return;

    var W = 80, H = 56;
    var SIT = 0, BLINK = 1, FLICK = 2, EAR = 3, STAND = 4, CROUCH = 5, GALLOP = 6;
    var GALLOP_N = 24, PUSH = 30, LEAP = 31, TUCK = 32, REACH = 33, LAND = 34, LIE = 35, SLEEP = 36, BREATHE = 37;
    var SETTLE = 38, LOOK = 39;
    var CURL_UP = 40, CURL_BLINK = 41, CURL_BACK = 42, CURL_SKY = 43, CURL_HALF = 44;
    // In-betweens: lifting the head (eyes shut, then open), turning it,
    // tipping it up, and breathing
    var LIFT = [45, 46, 44, 47, 48], TURN = [49, 50], TIP = [51, 52], BREATH = [36, 53, 54, 37];
    // In-betweens for the backflip, blended from the jump poses
    var STAND_CROUCH = 55, CROUCH_PUSH = 56, PUSH_LEAP = 57, LEAP_TUCK = [58, 59], TUCK_REACH = [60, 61];
    var REACH_LAND = 62, LAND_STAND = 63;
    // The body's poses through the air, in step with the turn: [until t, frame]
    var AIR = [
      [0.06, PUSH], [0.12, PUSH_LEAP], [0.2, LEAP], [0.26, LEAP_TUCK[0]], [0.32, LEAP_TUCK[1]],
      [0.66, TUCK], [0.72, TUCK_REACH[0]], [0.78, TUCK_REACH[1]], [0.92, REACH], [1.01, REACH_LAND]
    ];
    var STRIDE = 4.7; // px per gallop frame; 24 frames make a ~112px stride
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Top edge of the front range (mountains-4.svg), a height every 20 units
    var RIDGE = [88,81,74,67,59,52,45,38,31,23,16,9,11,17,24,31,38,45,51,58,65,69,63,56,61,67,73,80,86,92,98,105,111,117,123,130,136,142,148,140,132,124,115,107,96,85,73,62,50,39,28,16,5,7,18,29,39,50,61,58,52,62,71,81,91,101,111,121,124,119,115,111,107,103,98,94,90,86,81,77,73,69,64,62,66,70,74,78,82,86,90,94,98,102,106,110,114,118,122,126,130,134,131,116,102,87,95,109,119,108,97,86,75,64,53,42,45,55,66,76,79,67,55,43,30,18,7,18,7,18,30,41,47,40,33,38,44,51,57,64,70,77,83,89,96,102,109,115,122,122,115,109,103,96,90,83,77,70,64,58,51,45,44,50,56,62,68,74,80,87,93,99,105,111,117,117,106,95,84,73,62,51,48,59,69,80,80,69,58,51,62,72,83,93,103,114,124,134,145,155];

    // Layout position, ignoring transforms (sections fade up into place)
    function box(el) {
      if (!el || !el.offsetParent) return null;
      var x = 0, y = 0, n = el;
      while (n) {
        x += n.offsetLeft;
        y += n.offsetTop;
        n = n.offsetParent;
      }
      return { left: x, top: y, right: x + el.offsetWidth, bottom: y + el.offsetHeight, w: el.offsetWidth, h: el.offsetHeight, cx: x + el.offsetWidth / 2 };
    }
    function q(sel) {
      return document.querySelector(sel);
    }
    function qa(sel) {
      return [].slice.call(document.querySelectorAll(sel)).filter(function (e) {
        return e.offsetParent;
      });
    }
    function pt(x, y) {
      return { x: x, y: y };
    }
    function dist(a, b) {
      return Math.hypot(b.x - a.x, b.y - a.y);
    }
    function lerp(a, b, k) {
      return pt(a.x + (b.x - a.x) * k, a.y + (b.y - a.y) * k);
    }

    function ridgeBox() {
      var r = box(range);
      var sc = Math.min(r.w / 3991, r.h / 298);
      return { left: r.left + (r.w - 3991 * sc) / 2, top: r.top, sc: sc };
    }
    function ridgeAt(sx) {
      var i = Math.max(0, Math.min(RIDGE.length - 1.001, sx / 20)), j = Math.floor(i);
      return RIDGE[j] + (RIDGE[j + 1] - RIDGE[j]) * (i - j);
    }
    function ridgeStart(h) {
      // Well to the right, a little way down the face of the front range
      // (everything right of the dip is higher, so lower means off the ridge
      // line), never off screen
      var b = ridgeBox();
      var x = Math.min(h.left + h.w * 0.88, h.left + h.w - 50);
      var sx = (x - b.left) / b.sc;
      var drop = innerWidth < 768 ? 34 : 58;
      return pt(x, b.top + ridgeAt(sx) * b.sc + drop);
    }

    // Perch on top of a heading's last letter
    function onHeading(el) {
      var b = box(el);
      if (!b) return null;
      var em = parseFloat(getComputedStyle(el).fontSize);
      return pt(b.right - W / 2 + 4, b.top + em * 0.13);
    }
    // Stand on top of an element (cup, pill, icon, button)
    function onTop(el, dx) {
      var b = box(el);
      return b ? pt(b.cx + (dx || 0), b.top + 1) : null;
    }

    /*
      The route: legs between perches. Each leg is a list of moves, each move
      a run (along a surface), a hop (short jump) or a leap (long jump).
    */
    var legs, perches, stops;
    // Spots further down the page where he stays put and does something:
    // backflips in Technology, a nap in Contact. inSpot names the one he's at.
    var spots = {}, inSpot = '';
    function steps(frames, ms) {
      return frames.map(function (f) {
        return [f, ms];
      });
    }
    function back(frames) {
      return frames.slice().reverse();
    }
    var NAP = [].concat(
      steps(LIFT, 85), [[CURL_UP, 1200]],
      steps(TURN, 70), [[CURL_BACK, 1400]], steps(back(TURN), 70), [[CURL_UP, 450]],
      [[CURL_BLINK, 130]], [[CURL_UP, 550]],
      steps(TIP, 75), [[CURL_SKY, 1100]], steps(back(TIP), 75), [[CURL_UP, 400]],
      steps(back(LIFT), 95)
    );

    function build() {
      var h = box(hero);
      if (!h) return;
      var desktop = innerWidth >= 768;
      var ground = h.bottom - (desktop ? 34 : 26);
      var start = ridgeStart(h);
      perches = [{ at: start, pose: SIT }];
      legs = [];

      function addLeg(moves, at, pose) {
        moves = moves.filter(function (m) {
          return m.from && m.to;
        });
        if (!moves.length || !at) return false;
        legs.push(moves);
        perches.push({ at: at, pose: pose || SIT });
        return true;
      }

      // 1. Hero ridge -> down the hill -> along the ground -> leap onto ABOUT ME
      var about = onHeading(q('#about-heading .heading-text'));
      if (!about) return;
      var foot = pt(h.left + h.w * 0.66, ground);
      var launch = pt(Math.max(about.x + 70, Math.min(foot.x - 40, about.x + 160)), ground);
      if (launch.x > foot.x) launch.x = foot.x;
      addLeg([
        { kind: 'run', from: start, to: foot },
        { kind: 'run', from: foot, to: launch },
        { kind: 'leap', from: launch, to: about }
      ], about);

      // The other sections have spots instead of a route. Each takes over
      // just before its surface scrolls into view, so he's already there
      // when it does.
      spots = {};
      var maxS = document.documentElement.scrollHeight - innerHeight - 10;
      // Technology: on top of the filter bar, towards its right end
      var seg = box(q('.tech .seg'));
      if (seg) {
        spots.tricks = {
          at: pt(seg.right - (desktop ? 70 : 50), seg.top + 1),
          start: seg.top - innerHeight - 40
        };
      }
      // Contact: on top of the email box (the right end, by the Copy button)
      var mail = box(q('.contact .mail'));
      if (mail) {
        var sEnd = Math.min(maxS, mail.top - innerHeight * 0.4);
        spots.nap = {
          at: pt(mail.right - (desktop ? 80 : 56), mail.top + 1),
          start: Math.min(mail.top - innerHeight - 40, sEnd - 300)
        };
      }

      var maxScroll = document.documentElement.scrollHeight - innerHeight;
      stops = perches.map(function (p, i) {
        if (i === 0) return 0;
        var f = i === perches.length - 1 ? 0.62 : 0.55;
        return Math.min(maxScroll - 4, Math.max(0, p.at.y - innerHeight * f));
      });
      for (var i = 1; i < stops.length; i++) stops[i] = Math.max(stops[i], stops[i - 1] + 260);

      // Leaps take a little longer than their length
      legs.forEach(function (moves) {
        var sum = 0;
        moves.forEach(function (m) {
          if (m.path && m.path.length > 1) {
            m.len = 0;
            for (var j = 1; j < m.path.length; j++) m.len += dist(m.path[j - 1], m.path[j]);
          } else {
            m.len = dist(m.from, m.to);
          }
          m.cost = m.kind === 'run' ? m.len : m.len * 1.3 + (m.kind === 'hop' ? 30 : 60);
          sum += m.cost;
        });
        moves.forEach(function (m) {
          m.share = m.cost / sum;
        });
      });
      fox.classList.add('is-ready');
      update();
    }

    var lastP = null, facing = 1, lastX = null, frame = SIT, still = 0, idle = null, hold = 0;

    function show(f) {
      frame = f;
      sprite.style.backgroundPosition = -f * W + 'px 0';
    }

    // spin turns him about the middle of his body (a backflip), leaving the
    // shadow on the ground
    var PIVOT = 22;
    function place(p, f, lift, spin) {
      fox.style.setProperty('--lift', (lift || 0).toFixed(1));
      if (lastX !== null && Math.abs(p.x - lastX) > 0.4) facing = p.x < lastX ? 1 : -1;
      lastX = p.x;
      lastP = p;
      fox.style.transform = 'translate3d(' + (p.x - W / 2) + 'px,' + (p.y - H) + 'px,0)';
      sprite.style.transform = (facing < 0 ? 'scaleX(-1) ' : '') +
        (spin ? 'translateY(-' + PIVOT + 'px) rotate(' + spin.toFixed(1) + 'deg) translateY(' + PIVOT + 'px)' : '');
      show(f);
      fox.classList.toggle('is-asleep', BREATH.indexOf(f) !== -1);
      fox.classList.toggle('is-flipped', facing < 0);
    }

    // A point a distance d along a polyline
    function along(path, d) {
      for (var j = 1; j < path.length; j++) {
        var seg = dist(path[j - 1], path[j]);
        if (d <= seg) return lerp(path[j - 1], path[j], seg ? d / seg : 0);
        d -= seg;
      }
      return path[path.length - 1];
    }

    function jumpFrame(t) {
      return t < 0.08 ? CROUCH : t < 0.18 ? PUSH : t < 0.46 ? LEAP : t < 0.7 ? TUCK : t < 0.86 ? REACH : LAND;
    }

    function resting(i) {
      var pose = perches[i].pose;
      if (pose === SLEEP) return frame === BREATHE ? BREATHE : SLEEP;
      return idle !== null ? idle : SIT;
    }

    function update() {
      if (!legs || !legs.length) return;
      if (reduce) return place(perches[1].at, SIT);
      var y = scrollY;
      var nowSpot = spots.nap && y >= spots.nap.start ? 'nap' : spots.tricks && y >= spots.tricks.start ? 'tricks' : '';
      if (nowSpot !== inSpot) {
        // Changing places: fade in at the new one
        inSpot = nowSpot;
        fox.classList.remove('is-popping');
        void fox.offsetWidth;
        fox.classList.add('is-popping');
        lastX = null;
      }
      if (nowSpot === 'nap') {
        facing = 1;
        return place(spots.nap.at, napFrame);
      }
      if (nowSpot === 'tricks') return trickShow();
      var i = 0;
      while (i < stops.length - 1 && y >= stops[i + 1]) i++;
      if (i >= legs.length) return place(perches[i].at, resting(i));
      var a = stops[i], b = stops[i + 1];
      var p = (y - a) / (b - a);
      var go = 0.28; // rest on the perch for a moment before setting off
      if (p <= go) return place(perches[i].at, resting(i));
      var k = (p - go) / (1 - go);
      var moves = legs[i], acc = 0;
      for (var m = 0; m < moves.length; m++) {
        var mv = moves[m];
        if (k <= acc + mv.share || m === moves.length - 1) {
          var t = Math.min(1, Math.max(0, (k - acc) / mv.share));
          if (mv.kind === 'run') {
            var d = t * mv.len;
            var f = m === 0 && t < 0.03 ? STAND : m === 0 && d < 8 ? CROUCH : GALLOP + (Math.floor(d / STRIDE) % GALLOP_N);
            return place(mv.path ? along(mv.path, d) : lerp(mv.from, mv.to, t), f);
          }
          var arc = mv.kind === 'hop' ? 16 + mv.len * 0.12 : 30 + mv.len * 0.1;
          var climb = Math.max(0, mv.from.y - mv.to.y);
          var pos = lerp(mv.from, mv.to, t);
          var up = Math.sin(t * Math.PI) * (arc + climb * 0.4);
          pos.y -= up;
          var lastMove = m === moves.length - 1;
          var toBed = lastMove && perches[i + 1].pose === SLEEP;
          if (toBed && t > 0.9) return place(mv.to, t > 0.97 ? SLEEP : LIE);
          // Touching down on a perch, the rear sinks into the sit
          if (lastMove && t > 0.94) return place(mv.to, SETTLE);
          return place(pos, jumpFrame(t), up);
        }
        acc += mv.share;
      }
    }

    // Sitting still: now and then blink, flick the tail or twitch an ear.
    // Asleep: breathe slowly.
    setInterval(function () {
      if (reduce || !legs) return;
      // The nap and the flips run him themselves
      if (inSpot === 'nap' || flipping) return;
      if ((frame >= STAND && frame <= LIE) || frame === SETTLE) {
        still = 0;
        idle = null;
        return;
      }
      still += 1;
      if (frame === SLEEP || frame === BREATHE) {
        if (still % 7 === 0) show(frame === SLEEP ? BREATHE : SLEEP);
        return;
      }
      if (idle !== null) {
        if (--hold > 0) return;
        idle = null;
        show(SIT);
        return;
      }
      if (still > 4 && Math.random() < 0.16) {
        var r = Math.random();
        idle = r < 0.45 ? BLINK : r < 0.65 ? FLICK : r < 0.8 ? EAR : LOOK;
        // A look up lasts a while; the rest are a flicker
        hold = idle === LOOK ? 6 + Math.floor(Math.random() * 6) : 1;
        show(idle);
      }
    }, 220);

    // The nap in Contact: breathe slowly for a while, then lift his head and
    // look around before settling back down. Only runs while he's there.
    var napFrame = SLEEP;
    function napShow(f) {
      napFrame = f;
      if (inSpot !== 'nap') return;
      show(f);
      fox.classList.toggle('is-asleep', BREATH.indexOf(f) !== -1);
    }
    // Slow breaths: in over four frames, out over the same four
    function sleepFor(ms) {
      var BREATH_CYCLE = BREATH.concat(back(BREATH).slice(1, -1));
      var n = 0, ticks = Math.round(ms / 380);
      (function breathe() {
        if (n >= ticks && n % BREATH_CYCLE.length === 0) return wake(0);
        napShow(BREATH_CYCLE[n++ % BREATH_CYCLE.length]);
        setTimeout(breathe, 380);
      })();
    }
    function wake(j) {
      if (j >= NAP.length) {
        napShow(SLEEP);
        return sleepFor(6000 + Math.random() * 5000);
      }
      napShow(NAP[j][0]);
      setTimeout(function () {
        wake(j + 1);
      }, NAP[j][1]);
    }
    if (!reduce) sleepFor(4500);

    // Technology: sit a few seconds, then a backflip (sometimes a double).
    // The jump frames (crouch, push off, tuck, reach for the ground, land)
    // play over a real rotation, a frame at a time, so it turns smoothly.
    var trick = { frame: SIT, lift: 0, spin: 0 }, flipping = false;
    function trickShow() {
      if (inSpot !== 'tricks') return;
      facing = 1;
      var f = trick.frame === SIT && idle !== null ? idle : trick.frame;
      var at = spots.tricks.at;
      place(pt(at.x, at.y - trick.lift), f, trick.lift, trick.spin);
    }
    function pose(f, ms, next) {
      trick.frame = f;
      trick.lift = 0;
      trick.spin = 0;
      trickShow();
      setTimeout(next, ms);
    }
    function flip(turns, done) {
      flipping = true;
      idle = null;
      var dur = turns > 1 ? 1000 : 640, high = turns > 1 ? 64 : 44;
      pose(STAND, 180, function () {
        pose(STAND_CROUCH, 70, function () {
        pose(CROUCH, 140, function () {
        pose(CROUCH_PUSH, 60, function () {
          var t0 = performance.now();
          (function air(now) {
            var t = Math.min(1, (now - t0) / dur);
            var e = t * t * (3 - 2 * t);
            for (var j = 0; t >= AIR[j][0]; j++);
            trick.frame = AIR[j][1];
            trick.lift = Math.sin(t * Math.PI) * high;
            trick.spin = 360 * turns * e;
            trickShow();
            if (t < 1) return requestAnimationFrame(air);
            pose(LAND, 110, function () {
              pose(LAND_STAND, 80, function () {
                pose(STAND, 160, function () {
                  pose(SETTLE, 150, function () {
                    pose(SIT, 0, function () {
                      flipping = false;
                      done();
                    });
                  });
                });
              });
            });
          })(t0);
        });
        });
        });
      });
    }
    function tricks() {
      setTimeout(function () {
        // Only when he's there and the tab is showing
        if (inSpot !== 'tricks' || document.hidden) return tricks();
        flip(Math.random() < 0.25 ? 2 : 1, tricks);
      }, 2600 + Math.random() * 2400);
    }
    if (!reduce) tricks();

    // Sitting, he notices the pointer coming close and turns to face it
    var looking = false;
    addEventListener(
      'pointermove',
      function (e) {
        if (reduce || looking || !lastP || e.pointerType !== 'mouse') return;
        looking = true;
        requestAnimationFrame(function () {
          looking = false;
          var sitting = frame <= EAR || frame === LOOK;
          if (!sitting) return;
          var mx = e.clientX + scrollX, my = e.clientY + scrollY;
          var dx = mx - lastP.x, dy = my - (lastP.y - H / 2);
          if (dx * dx + dy * dy > 170 * 170 || Math.abs(dx) < 12) return;
          var want = dx < 0 ? 1 : -1;
          if (want === facing) return;
          facing = want;
          sprite.style.transform = facing < 0 ? 'scaleX(-1)' : '';
          fox.classList.toggle('is-flipped', facing < 0);
        });
      },
      { passive: true }
    );

    var ticking = false;
    addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        update();
      });
    }, { passive: true });
    var timer;
    function rebuild() {
      clearTimeout(timer);
      timer = setTimeout(build, 120);
    }
    addEventListener('resize', rebuild);
    addEventListener('load', build);
    if (document.fonts) document.fonts.ready.then(build);
    // The technology filter changes which icons he can hop on
    build();
  });
</script>

<style>
  .fox {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: 80px;
    height: 56px;
    pointer-events: none;
    visibility: hidden;
    will-change: transform;
  }

  .fox.is-ready {
    visibility: visible;
  }

  /* Moving between the About perch and the Contact nap: he fades in */
  .fox.is-popping .fox__sprite {
    animation: fox-pop 0.35s ease-out;
  }

  @keyframes fox-pop {
    from {
      opacity: 0;
    }
  }

  /* A soft contact shadow that stays on the surface while he jumps */
  .fox__shadow {
    --l: calc(var(--lift, 0) * 1px);
    position: absolute;
    left: 50%;
    bottom: -3px;
    width: 36px;
    height: 6px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.32), transparent);
    translate: -50% var(--l);
    scale: max(0.35, 1 - var(--lift, 0) / 90);
    opacity: max(0.25, 1 - var(--lift, 0) / 70);
  }

  .fox__sprite {
    position: relative;
    width: 100%;
    height: 100%;
    background: url('/images/fox-sprite.svg') 0 0 / 5120px 56px no-repeat;
    transform-origin: 50% 100%;
  }

  /* Asleep: a few small z's drift up and fade, one after another */
  .fox__z {
    position: absolute;
    left: 30px;
    top: 4px;
    display: none;
  }

  .fox.is-asleep .fox__z {
    display: block;
  }

  /* The z's rise from his head, whichever way he's lying */
  .fox.is-flipped .fox__z {
    left: 46px;
  }

  .fox__z i {
    position: absolute;
    left: 0;
    top: 0;
    font: 700 11px/1 var(--font-body);
    font-style: normal;
    color: var(--pigeon-post);
    opacity: 0;
    animation: snooze 3.6s ease-out infinite;
  }

  .fox__z i:nth-child(2) {
    font-size: 9px;
    animation-delay: 1.2s;
  }

  .fox__z i:nth-child(3) {
    font-size: 13px;
    animation-delay: 2.4s;
  }

  @keyframes snooze {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(-10deg);
    }
    20% {
      opacity: 0.85;
    }
    100% {
      opacity: 0;
      transform: translate(14px, -30px) rotate(12deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fox__z {
      display: none !important;
    }
  }

  /* Drawn a little under the sprite's size (feet stay put: origin is the
     bottom centre), and smaller again on phones */
  .fox__sprite {
    scale: 0.78;
  }

  @media (max-width: 767px) {
    .fox__sprite {
      scale: 0.64;
    }
  }

  /* During the home intro he waits until the mountains are in, then appears */
  :global(html.intro:not(.intro-go)) .fox {
    opacity: 0;
  }

