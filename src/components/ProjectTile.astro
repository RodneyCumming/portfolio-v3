---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0') + '.';
---

<article class="tile" style={`--bg: ${project.bg}; --shadow: ${project.shadow}; --overlay: ${project.overlay ?? project.bg}`}>
  <span class="tile__number" aria-hidden="true">{number}</span>

  <a class="tile__link" href={project.link} rel="noopener">
    <span class="tile__float">
      <Image src={project.image} alt={`${project.name.toLowerCase()} screenshot`} width={600} loading={index < 2 ? 'eager' : 'lazy'} />
      <span class="tile__tint" aria-hidden="true"></span>
    </span>
    <span class="tile__shadow" aria-hidden="true"></span>
    <h2 class="tile__title">{project.name}</h2>
  </a>

  {project.github && (
    <a class="tile__github" href={project.github} rel="noopener" aria-label={`${project.name} on GitHub`}>
      <svg viewBox="0 0 16 16" width="50" height="50" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.3 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
  )}
</article>

<style>
  .tile {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100%;
    padding: max(12%, 72px) 10% 16%;
    background: var(--bg);
    box-shadow: inset 0 0 50px 50px var(--shadow);
    filter: brightness(95%);
    transition: filter 0.3s;
  }

  .tile:hover {
    filter: brightness(110%);
  }

  .tile__number {
    position: absolute;
    top: 5%;
    left: 5%;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 35px;
    letter-spacing: 5px;
    line-height: 1;
    color: #fff;
  }

  .tile__link {
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 600px;
    text-decoration: none;
  }

  .tile__float {
    position: relative;
    display: block;
  }

  .tile__float img {
    width: 100%;
    height: auto;
  }

  .tile__tint {
    position: absolute;
    inset: 0;
    background: var(--overlay);
    opacity: 0.5;
    transition: opacity 0.3s;
  }

  .tile:hover .tile__tint {
    opacity: 0.25;
  }

  .tile__shadow {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -90px;
    height: 45px;
    border-radius: 50%;
    background: var(--shadow);
    box-shadow: inset 0 0 10px 10px var(--bg);
    display: none;
  }

  @media (min-width: 768px) {
    .tile__shadow {
      display: block;
    }
  }

  .tile__title {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: max-content;
    max-width: 90%;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 4vw, 45px);
    line-height: 1;
    color: #fff;
    text-align: center;
  }

  .tile__github {
    position: absolute;
    top: 5%;
    right: 5%;
    color: color-mix(in srgb, var(--bg), white 55%);
    transition: color 0.2s;
  }

  .tile__github:hover {
    color: #fff;
  }

  .tile__github svg {
    width: 40px;
    height: 40px;
  }

  @media (min-width: 768px) {
    .tile__github svg {
      width: 50px;
      height: 50px;
    }
  }

  /* The screenshot floats while the tile is hovered, as before */
  @media (prefers-reduced-motion: no-preference) {
    .tile__float,
    .tile__shadow {
      animation: 3s cubic-bezier(0.6, 0.4, 0.4, 0.6) infinite paused;
    }
    .tile__float {
      animation-name: float;
    }
    .tile__shadow {
      animation-name: breathe;
    }
    .tile:hover .tile__float,
    .tile:hover .tile__shadow {
      animation-play-state: running;
    }
  }

  @keyframes float {
    0%,
    100% {
      translate: 0 -20px;
    }
    50% {
      translate: 0 0;
    }
  }

  @keyframes breathe {
    50% {
      scale: 1 1.2;
    }
  }
</style>
