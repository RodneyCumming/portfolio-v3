---
import Odo from './Odo.astro';
import { Image } from 'astro:assets';
import smartcompare from '../assets/projects/smartcompare.png';
import stoicism from '../assets/projects/stoicism-now-phone.png';

// A taste of the portfolio: three products, then on to the full page
const picks = [
  {
    name: 'SmartCompare',
    text: 'Every NZ mobile plan on one page.',
    where: 'Web',
    href: 'https://smartcompare.co.nz',
    shot: 'site',
  },
  {
    name: 'Stoicism Now',
    text: 'Stoic quotes with exact sources.',
    where: 'Web',
    href: 'https://stoicismnow.com',
    shot: 'phone',
  },
  {
    name: 'Immerse',
    text: 'Read along with the audiobook.',
    where: 'Apps',
    href: '/portfolio',
    shot: 'reader',
  },
];
---

<section class="section work" aria-labelledby="work-heading">
  <div class="section__inner">
    <div class="head-row">
      <div>
        <p class="eyebrow" data-live><Odo value="03" />&nbsp; Portfolio</p>
        <h2 id="work-heading" class="section__heading is-left"><span class="heading-text">PORTFOLIO</span></h2>
        <p class="sub">Products I've built, <em>start to finish.</em></p>
      </div>
      <a class="all" href="/portfolio">See all 6 projects <span aria-hidden="true">→</span></a>
    </div>

    <ul class="picks" role="list">
      {picks.map((p, i) => (
        <li style={`--i: ${i}`}>
          <a href={p.href} rel={p.href.startsWith('http') ? 'noopener' : undefined}>
            <span class:list={['shot', `shot--${p.shot}`]} aria-hidden="true">
              {p.shot === 'site' && (
                <Image src={smartcompare} alt="" widths={[400, 800]} sizes="(min-width: 900px) 380px, 92vw" loading="lazy" />
              )}
              {p.shot === 'phone' && (
                <Image class="px" src={stoicism} alt="" widths={[200, 400]} sizes="150px" loading="lazy" style="--from: 18px; --to: -18px" />
              )}
              {p.shot === 'reader' && (
                <span class="page">
                  <span class="page__top"><span>Pride and Prejudice</span><span>Chapter 1</span></span>
                  It is a truth universally acknowledged, that a single man in possession of a good fortune, must be in
                  want of a wife. <mark>However little known the feelings or views of such a man may be on his first
                  entering a neighbourhood,</mark> this truth is so well fixed in the minds of the surrounding families.
                </span>
              )}
            </span>
            <span class="cap">
              <span class="name">{p.name}</span>
              <span class="where">{p.where}</span>
            </span>
            <span class="text">{p.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work {
    background: var(--ebony-clay);
  }

  /* The way through to the full portfolio */
  .all {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border: 1.5px solid #3c4565;
    border-radius: 999px;
    font: 700 15px var(--font-body);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s;
  }

  .all span {
    color: var(--muted);
    transition: transform 0.25s, color 0.2s;
  }

  .all:hover {
    border-color: var(--accent);
  }

  .all:hover span {
    color: var(--accent);
    transform: translateX(3px);
  }

  .picks {
    display: grid;
    gap: 40px 28px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .picks a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Every product gets the same frame: the work is the picture */
  .shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: #2b3349;
    container-type: inline-size;
  }

  .shot :global(img) {
    display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .shot--site :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .picks a:hover .shot--site :global(img) {
    transform: scale(1.025);
  }

  .shot--phone {
    display: flex;
    justify-content: center;
    background: #e9ebf6;
  }

  .shot--phone :global(img) {
    width: 38%;
    height: auto;
    margin-top: 7%;
    border-radius: 4.5cqw 4.5cqw 0 0;
  }

  .shot--reader {
    display: grid;
    place-items: center;
    background: #e8e2d4;
  }

  .page {
    display: block;
    width: 80%;
    padding: 4.7cqw 5.8cqw;
    border-radius: 1.6cqw;
    background: #f6f1e7;
    font: 3.7cqw/1.7 Georgia, 'Times New Roman', serif;
    color: #3b3a36;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .picks a:hover .page {
    transform: translateY(-1.5cqw);
  }

  .page__top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 2cqw;
    font: 2.6cqw var(--font-body);
    color: #8b867b;
  }

  /* The phrase being narrated. The highlight is a background strip so it
     can sweep along the phrase, line by line. */
  mark {
    border-radius: 2px;
    background: linear-gradient(rgb(55 194 180 / 0.3), rgb(55 194 180 / 0.3)) 0 0 / 100% 100% no-repeat;
    color: inherit;
  }

  .cap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 16px;
  }

  .name {
    font: 700 19px var(--font-body);
    color: var(--ink);
    transition: color 0.2s;
  }

  .picks a:hover .name {
    color: var(--accent);
  }

  .where {
    font: 700 11px var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .text {
    display: block;
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Scroll choreography: the three rise in one after another, and the
     reader's highlight sweeps along its phrase */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .picks {
        view-timeline: --picks block;
      }
      .picks li {
        --rise: 40px;
        animation: fade-rise linear both;
      }
      .work .picks li {
        animation-timeline: --picks;
        animation-range: entry calc(var(--i) * 12%) cover calc(30% + var(--i) * 6%);
      }
      mark {
        animation: sweep linear both;
      }
      .work mark {
        animation-timeline: --picks;
        animation-range: cover 30% cover 55%;
      }
    }
  }

  @keyframes sweep {
    from {
      background-size: 0 100%;
    }
  }

  @media (min-width: 640px) and (max-width: 899px) {
    .picks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .picks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
