---
import { Image } from 'astro:assets';
import smartcompare from '../assets/projects/smartcompare.png';
import stoicism from '../assets/projects/stoicism-now-phone.png';
import seoLamp from '../assets/projects/seo-lamp.png';
import habits from '../assets/projects/quantified-habits.png';
import ProjectDemo from './ProjectDemo.astro';

// Immerse: the passage is read along as you scroll, phrase by phrase
const passage = [
  'It is a truth universally acknowledged,',
  'that a single man in possession of a good fortune,',
  'must be in want of a wife.',
  'However little known the feelings or views of such a man may be',
  'on his first entering a neighbourhood,',
  'this truth is so well fixed in the minds of the surrounding families,',
  'that he is considered the rightful property',
  'of some one or other of their daughters.',
];
const sets = [
  ['Bench press', '4 × 8 · 70 kg'],
  ['Overhead press', '3 × 10 · 40 kg'],
  ['Incline dumbbell', '3 × 12 · 22 kg'],
  ['Triceps dips', '3 × 15'],
];

const sites = [
  {
    n: '01',
    name: 'SmartCompare',
    text: 'Compares 113 NZ mobile plans from 16 providers, so you can find a better deal in under a minute. Every page is static for speed; filters, a plan finder and calculators run on top.',
    stack: 'Next.js · React · CSS Modules',
    url: 'https://smartcompare.co.nz',
    host: 'smartcompare.co.nz',
    image: smartcompare,
    brand: '#2fae78',
    size: 'lead',
    demo: 'plans' as const,
  },
  {
    n: '02',
    name: 'Stoicism Now',
    text: 'Stoic quotes with exact sources, the full texts, and guides to the ideas.',
    stack: 'Next.js · Postgres',
    url: 'https://stoicismnow.com',
    host: 'stoicismnow.com',
    image: stoicism,
    brand: '#7f8cff',
    size: 'tall',
    demo: 'quote' as const,
  },
  {
    n: '03',
    name: 'SEO Lamp',
    text: 'Free SEO tools and whole-site audits, ranked by what to fix first.',
    stack: 'Next.js · Supabase · Stripe',
    url: 'https://seolamp.vercel.app',
    host: 'seolamp.vercel.app',
    image: seoLamp,
    brand: '#e8b84a',
    demo: 'audit' as const,
  },
  {
    n: '04',
    name: 'Quantified Habits',
    text: "Habits, tasks and todos on one board, with the numbers that show it's working.",
    stack: 'Next.js · MUI · Supabase',
    url: 'https://quantifiedhabits.vercel.app',
    host: 'quantifiedhabits.vercel.app',
    image: habits,
    brand: '#ff7a4d',
    demo: 'board' as const,
  },
];
---

<section class="section work" aria-labelledby="work-heading">
  <div class="section__inner">
    <div class="head-row">
      <div>
        <p class="eyebrow">03&nbsp; Portfolio</p>
        <h2 id="work-heading" class="section__heading is-left"><span class="heading-text">PORTFOLIO</span></h2>
        <p class="sub">Products I've built, <em>start to finish.</em></p>
      </div>
      <a class="more" href="/portfolio">All projects →</a>
    </div>

    <div class="bento">
      {sites.map((p, i) => (
        <article class:list={['card', p.size]} style={`--brand: ${p.brand}; --d: ${[0, 1, 0, 1][i]}`}>
          <div class="stage">
            <a class="win" href={p.url} rel="noopener" tabindex="-1" aria-hidden="true">
              <span class="win__bar"><i></i><i></i><i></i><span>{p.host}</span></span>
              <span class="win__view">
                <Image class="px-pan" src={p.image} alt="" widths={[600, 900, 1200]} sizes="(min-width: 1025px) 760px, 92vw" loading="lazy" />
              </span>
            </a>
            <ProjectDemo kind={p.demo} />
          </div>
          <div class="meta">
            <span class="n">{p.n}</span>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
            <div class="foot">
              <span>{p.stack}</span>
              <a href={p.url} rel="noopener">Visit<span class="visually-hidden"> {p.name}</span> →</a>
            </div>
          </div>
        </article>
      ))}

      <!-- Quantified Gym: no site; a drawing of a workout in the app -->
      <article class="card gym" style="--brand: #6f9bff; --d: 2">
        <div class="phone" aria-hidden="true">
          <p class="phone__top">Today · Push</p>
          {sets.map(([name, detail], k) => (
            <p class="ex" style={`--k: ${k}`}><b>{name}</b><span>{detail}</span></p>
          ))}
          <p class="rest" data-rest="45">
            <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="8" pathLength="1"></circle><circle cx="10" cy="10" r="8" pathLength="1"></circle></svg>
            Rest <b>0:45</b>
          </p>
        </div>
        <div class="meta">
          <span class="n">05</span>
          <h3>Quantified Gym</h3>
          <p>A workout app for Android, built with React and Capacitor, that works fully offline.</p>
          <div class="foot"><span>React · Ionic · Capacitor</span><span class="where">Android</span></div>
        </div>
      </article>

      <!-- Immerse: a page being read along with the audiobook -->
      <article class="card wide" style="--brand: #37c2b4; --d: 0">
        <div class="meta">
          <span class="n">06</span>
          <h3>Immerse</h3>
          <p>An Apple Books-style reader that highlights each sentence as the audiobook narrates it, on Mac, iPad and Android.</p>
          <div class="foot"><span>JavaScript · Swift · Kotlin</span><span class="where">Mac · iPad · Android</span></div>
        </div>
        <div class="reader" aria-hidden="true">
          <p class="reader__top"><span>Pride and Prejudice</span><span>Chapter 1</span></p>
          <p class="reader__text">
            {passage.map((phrase, k) => (
              <>
                <mark style={`--k: ${k}`}>{phrase}</mark>{' '}
              </>
            ))}
          </p>
          <p class="wave" aria-hidden="true">
            {Array.from({ length: 36 }, (_, k) => (
              <i style={`--h: ${(0.35 + 0.65 * Math.abs(Math.sin(k * 1.7) * Math.cos(k * 0.45))).toFixed(2)}; --k: ${k}`}></i>
            ))}
          </p>
          <p class="reader__audio"><b>▶</b><span><i></i></span><small>12:41 / 37:10</small></p>
        </div>
      </article>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var loops = [];

    // Each loop runs only while its element is on screen
    function live(el, start) {
      if (!el || reduce) return;
      var timer = null;
      var io = new IntersectionObserver(function (e) {
        var on = e[0].isIntersecting;
        el.classList.toggle('is-live', on);
        if (on && !timer) timer = start();
        if (!on && timer) {
          timer.stop();
          timer = null;
        }
      }, { threshold: 0.35 });
      io.observe(el);
      loops.push(io);
    }

    function every(ms, fn) {
      fn();
      var id = setInterval(fn, ms);
      return { stop: function () { clearInterval(id); } };
    }

    // SmartCompare: shuffle the plans, then sort them cheapest first
    live(document.querySelector('[data-demo="plans"]'), function () {
      var el = document.querySelector('[data-demo="plans"]');
      var rows = [].slice.call(el.querySelectorAll('li'));
      var step = 0;
      function place(order) {
        order.forEach(function (row, i) {
          row.style.setProperty('--y', i);
          row.classList.toggle('best', i === 0 && step % 2 === 1);
        });
      }
      return every(2600, function () {
        step++;
        var order = rows.slice();
        if (step % 2) {
          order.sort(function (a, b) {
            return a.dataset.price - b.dataset.price;
          });
        } else {
          order.sort(function () {
            return Math.random() - 0.5;
          });
        }
        place(order);
      });
    });

    // Stoicism Now: decode a quote from scrambled letters, then the next
    live(document.querySelector('[data-demo="quote"]'), function () {
      var el = document.querySelector('[data-demo="quote"]');
      var q = el.querySelector('.quote');
      var by = el.querySelector('.quote__by');
      var quotes = JSON.parse(q.dataset.quotes);
      var n = 0;
      var raf = null;
      var glyphs = 'abcdefghijklmnopqrstuvwxyz';
      function decode(text) {
        var t0 = performance.now();
        el.classList.add('is-scrambling');
        cancelAnimationFrame(raf);
        (function frame(t) {
          var p = Math.min(1, (t - t0) / 1400);
          var shown = Math.floor(p * text.length);
          var out = text.slice(0, shown);
          for (var i = shown; i < text.length; i++) {
            out += text[i] === ' ' ? ' ' : glyphs[(Math.random() * 26) | 0];
          }
          q.textContent = out;
          if (p < 1) raf = requestAnimationFrame(frame);
          else el.classList.remove('is-scrambling');
        })(t0);
      }
      var timer = every(6500, function () {
        var item = quotes[n++ % quotes.length];
        by.textContent = item[1];
        decode(item[0]);
      });
      return { stop: function () { timer.stop(); cancelAnimationFrame(raf); } };
    });

    // SEO Lamp: reset, then the scores sweep up and the checks pass
    live(document.querySelector('[data-demo="audit"]'), function () {
      var el = document.querySelector('[data-demo="audit"]');
      var nums = [].slice.call(el.querySelectorAll('[data-to]'));
      var checks = [].slice.call(el.querySelectorAll('.checks li'));
      var timers = [];
      function run() {
        el.classList.add('is-reset');
        nums.forEach(function (b) { b.textContent = '0'; });
        timers.push(setTimeout(function () {
          el.classList.remove('is-reset');
          var t0 = performance.now();
          (function count(t) {
            var p = Math.min(1, (t - t0) / 1600);
            var e = 1 - Math.pow(1 - p, 3);
            nums.forEach(function (b) { b.textContent = Math.round(e * b.dataset.to); });
            if (p < 1) requestAnimationFrame(count);
          })(t0);
        }, 400));
        // Checks fail first, then pass one after another
        checks.forEach(function (c, i) {
          c.classList.add('fail');
          timers.push(setTimeout(function () { c.classList.remove('fail'); }, 1500 + i * 650));
        });
      }
      var timer = every(7000, run);
      return { stop: function () { timer.stop(); timers.forEach(clearTimeout); } };
    });

    // Quantified Habits: the run card crosses the board, then starts again
    live(document.querySelector('[data-demo="board"]'), function () {
      var card = document.querySelector('[data-demo="board"] .task--move');
      var col = 0;
      return every(1700, function () {
        col = (col + 1) % 4;
        var c = col === 3 ? 0 : col;
        card.classList.remove('is-lifting');
        void card.offsetWidth;
        if (c !== 0) card.classList.add('is-lifting');
        card.style.setProperty('--col', c);
      });
    });

    // Gym: the rest timer counts down, then the next set
    live(document.querySelector('.rest'), function () {
      var el = document.querySelector('.rest');
      var b = el.querySelector('b');
      var total = +el.dataset.rest;
      var left = total;
      return every(1000, function () {
        left = left <= 0 ? total : left - 1;
        b.textContent = '0:' + String(left).padStart(2, '0');
        el.style.setProperty('--rest', (1 - left / total).toFixed(3));
      });
    });

    // Immerse: the waveform breathes while the page is on screen
    live(document.querySelector('.wave'), function () {
      return { stop: function () {} };
    });
  })();
</script>

<style>
  .work {
    background: var(--ebony-clay);
  }

  .more {
    font: 700 15px var(--font-body);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .bento {
    display: grid;
    gap: 22px;
    margin-top: 56px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--panel);
  }

  .stage {
    position: relative;
  }

  .win {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
  }

  .win__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    background: #e9ecf2;
  }

  .win__bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #c7ccd8;
  }

  .win__bar span {
    min-width: 40%;
    margin: 0 auto;
    padding: 3px 14px;
    border-radius: 6px;
    background: #fff;
    font: 12px var(--font-body);
    color: #5b647d;
    text-align: center;
  }

  .win__view {
    display: block;
    height: 200px;
    overflow: hidden;
  }

  .win__view :global(img) {
    display: block;
    width: 100%;
    height: 150%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .meta {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 8px 6px;
  }

  .n {
    font: 700 13px var(--font-body);
    letter-spacing: 0.2em;
    color: var(--brand);
  }

  h3 {
    margin-top: 6px;
    font: 700 38px/1 var(--font-display);
    letter-spacing: 0.4px;
    color: var(--ink);
  }

  .meta p {
    margin-top: 12px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: #aeb6cd;
  }

  .meta p + .foot {
    margin-top: 18px;
  }

  .foot a {
    font: 700 14px var(--font-body);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .foot a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .where {
    white-space: nowrap;
  }

  /* Quantified Gym: a drawn phone */
  .phone {
    align-self: center;
    width: 230px;
    overflow: hidden;
    padding: 18px 14px;
    border: 7px solid #1b2133;
    border-radius: 30px;
    background: #f4f6fb;
  }

  .phone__top {
    margin-bottom: 12px;
    font: 700 15px var(--font-body);
    color: #1b2234;
  }

  .ex {
    position: relative;
    display: grid;
    gap: 2px;
    margin-bottom: 8px;
    padding: 9px 36px 9px 10px;
    border: 1px solid #e3e7f0;
    border-radius: 10px;
    background: #fff;
  }

  .ex b {
    font-size: 13px;
    color: #1b2234;
  }

  .ex span {
    font-size: 11px;
    color: #6b7390;
  }

  .ex::after {
    content: '';
    position: absolute;
    right: 11px;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-top: -9px;
    border: 2px solid #c7ccd8;
    border-radius: 50%;
  }


  /* Gym: a rest timer counting down between sets */
  .rest {
    width: max-content;
    margin: 10px auto 0;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px 6px 8px;
    border-radius: 999px;
    background: #1b2234;
    color: #fff;
    font: 700 11px var(--font-body);
    white-space: nowrap;
  }

  .rest b {
    font-variant-numeric: tabular-nums;
  }

  .rest svg {
    width: 18px;
    height: 18px;
    transform: rotate(-90deg);
  }

  .rest circle {
    fill: none;
    stroke-width: 2.6;
    stroke: rgb(255 255 255 / 0.2);
  }

  .rest circle + circle {
    stroke: var(--brand);
    stroke-dasharray: 1;
    stroke-dashoffset: var(--rest, 0);
    transition: stroke-dashoffset 1s linear;
  }

  /* Immerse: a page with the narrated sentence highlighted */
  .reader {
    margin-top: 18px;
    padding: 22px 24px;
    border-radius: 14px;
    background: #f7f3ea;
    color: #2b2a27;
  }

  .reader__top {
    display: flex;
    justify-content: space-between;
    font: 12px var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a8473;
  }

  .reader__text {
    margin-top: 14px;
    font: 16px/1.75 Georgia, 'Times New Roman', serif;
  }

  mark {
    padding: 1px 0;
    border-radius: 4px;
    background: transparent;
    color: inherit;
  }

  /* Without scroll-driven animation, one phrase stays highlighted */
  mark:nth-child(4) {
    background: #cdeee9;
  }

  .wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 28px;
    margin-top: 14px;
  }

  .wave i {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: 2px;
    background: #d9d2c0;
    transform-origin: 50% 50%;
  }

  .wave.is-live i {
    animation: breathe 1.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--k) * -0.11s);
    background: color-mix(in srgb, var(--brand) 55%, #d9d2c0);
  }

  @keyframes breathe {
    from {
      transform: scaleY(0.45);
    }
  }

  .reader__audio {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }

  .reader__audio b {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-size: 11px;
  }

  .reader__audio > span {
    flex: 1;
    height: 4px;
    border-radius: 9px;
    background: #e2dccd;
  }

  .reader__audio i {
    display: block;
    transform-origin: 0 50%;
    width: 100%;
    transform: scaleX(0.34);
    height: 100%;
    border-radius: 9px;
    background: var(--brand);
  }

  .reader__audio small {
    font: 12px var(--font-body);
    color: #8a8473;
  }

  /* Scroll choreography */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* SmartCompare starts tipped back in 3D and swings flat as it arrives */
      .lead .win {
        animation: swing-flat linear both;
      }
      .work .lead .win {
        animation-timeline: view();
        animation-range: entry 0% cover 42%;
      }

      /* The other cards are unveiled from the bottom up */
      .card:not(.lead) {
        animation: unveil linear both;
      }
      .work .card:not(.lead) {
        animation-timeline: view();
        animation-range: entry calc(var(--d) * 8%) entry calc(85% + var(--d) * 5%);
      }

      /* The workout ticks off set by set, and its bar fills */
      .gym {
        view-timeline: --gym block;
      }
      .ex::after {
        animation: tick linear both;
      }
      .gym .ex::after {
        animation-timeline: --gym;
        animation-range: cover calc(30% + var(--k) * 9%) cover calc(34% + var(--k) * 9%);
      }

      /* Immerse reads along: the highlight moves through the passage,
         phrase by phrase, and the audio bar keeps pace */
      .wide {
        view-timeline: --read block;
      }
      mark {
        animation: read-along linear both;
      }
      .wide mark {
        animation-timeline: --read;
        animation-range: cover calc(22% + var(--k) * 6%) cover calc(30% + var(--k) * 6%);
      }
      .wide mark:nth-child(4) {
        background: transparent;
      }
      .reader__audio i {
        animation: fill-bar linear both;
      }
      .wide .reader__audio i {
        animation-timeline: --read;
        animation-range: cover 22% cover 78%;
      }
    }
  }

  @keyframes swing-flat {
    from {
      transform: perspective(1400px) rotateX(28deg) scale(0.86) translateY(60px);
      opacity: 0.4;
    }
  }

  @keyframes unveil {
    from {
      clip-path: inset(100% 0 0 0 round 20px);
      transform: translateY(40px);
    }
    to {
      clip-path: inset(0 0 0 0 round 20px);
    }
  }

  @keyframes tick {
    from {
      border-color: #c7ccd8;
      background: transparent;
      transform: scale(1);
    }
    50% {
      transform: scale(1.35);
    }
    to {
      border-color: var(--brand);
      background: var(--brand);
      transform: scale(1);
    }
  }

  @keyframes fill-bar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes read-along {
    0%,
    100% {
      background: transparent;
    }
    20%,
    80% {
      background: #cdeee9;
    }
  }

  @media (hover: hover) {
    .card:hover .win__view :global(img) {
      transform: translateY(-4%);
    }
  }

  @media (min-width: 700px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .lead,
    .wide {
      grid-column: span 2;
    }
    .wide {
      flex-direction: row;
      align-items: center;
      gap: 26px;
      padding: 22px;
    }
    .wide .meta {
      flex: 1;
    }
    .wide .reader {
      flex: 1.15;
      margin-top: 0;
    }
  }

  @media (min-width: 1025px) {
    .bento {
      grid-template-columns: repeat(6, 1fr);
    }
    .card {
      grid-column: span 2;
    }
    .lead {
      grid-column: span 4;
    }
    .wide {
      grid-column: span 6;
    }
    .lead .win__view {
      height: 380px;
    }
    .tall .win__view {
      height: 470px;
    }
    .lead h3 {
      font-size: 54px;
    }
    .lead .meta p {
      max-width: 640px;
      font-size: 17px;
    }
    .win__view {
      height: 220px;
    }
    .reader__text {
      font-size: 17px;
    }
  }
</style>
