---
import Odo from './Odo.astro';
import { Image } from 'astro:assets';
import smartcompare from '../assets/projects/smartcompare.png';
import stoicism from '../assets/projects/stoicism-now-phone.png';
import seoLamp from '../assets/projects/seo-lamp.png';
import habits from '../assets/projects/quantified-habits.png';

// The whole portfolio: six products, each in the same frame. Products with
// a live site link to it; the two apps have no site, so they aren't links.
const picks = [
  {
    name: 'SmartCompare',
    text: 'Every NZ mobile plan on one page.',
    where: 'Web',
    href: 'https://smartcompare.co.nz',
    shot: 'site',
    image: smartcompare,
  },
  {
    name: 'Stoicism Now',
    text: 'Stoic quotes with exact sources.',
    where: 'Web',
    href: 'https://stoicismnow.com',
    shot: 'phone',
  },
  {
    name: 'Immerse',
    text: 'Read along with the audiobook.',
    where: 'Apps',
    shot: 'reader',
  },
  {
    name: 'SEO Lamp',
    text: 'Free SEO tools and whole-site audits.',
    where: 'Web',
    href: 'https://seolamp.vercel.app',
    shot: 'site',
    image: seoLamp,
  },
  {
    name: 'Quantified Habits',
    text: 'Habits, tasks and todos on one board.',
    where: 'Web',
    href: 'https://quantifiedhabits.vercel.app',
    shot: 'site',
    image: habits,
  },
  {
    name: 'Quantified Gym',
    text: 'A workout log that works fully offline.',
    where: 'Android',
    shot: 'gym',
  },
];

const sets = [
  ['Bench press', '4 × 8 · 70 kg'],
  ['Overhead press', '3 × 10 · 40 kg'],
  ['Incline dumbbell', '3 × 12 · 22 kg'],
  ['Triceps dips', '3 × 15'],
];
---

<section class="section work" id="portfolio" aria-labelledby="work-heading">
  <div class="section__inner">
    <p class="eyebrow" data-live><Odo value="02" />&nbsp; Portfolio</p>
    <h2 id="work-heading" class="section__heading is-left"><span class="heading-text">PORTFOLIO</span></h2>
    <p class="sub">Things I've made <em>in my spare time.</em></p>

    <ul class="picks" role="list">
      {picks.map((p) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <li>
            <Tag class="card" href={p.href} rel={p.href ? 'noopener' : undefined}>
              <span class:list={['shot', `shot--${p.shot}`]} aria-hidden="true">
                {p.shot === 'site' && p.image && (
                  <Image src={p.image} alt="" widths={[400, 800]} sizes="(min-width: 900px) 380px, (min-width: 640px) 46vw, 92vw" loading="lazy" />
                )}
                {p.shot === 'phone' && (
                  <Image class="px" src={stoicism} alt="" widths={[200, 400]} sizes="180px" loading="lazy" style="--from: 18px; --to: -18px" />
                )}
                {p.shot === 'reader' && (
                  <span class="page">
                    <span class="page__top"><span>Pride and Prejudice</span><span>Chapter 1</span></span>
                    It is a truth universally acknowledged, that a single man in possession of a good fortune, must be in
                    want of a wife. <mark>However little known the feelings or views of such a man may be on his first
                    entering a neighbourhood,</mark> this truth is so well fixed in the minds of the surrounding families.
                  </span>
                )}
                {p.shot === 'gym' && (
                  <span class="gym px" style="--from: 18px; --to: -18px">
                    <span class="gym__top">Today · Push</span>
                    {sets.map(([name, detail], k) => (
                      <span class="ex" style={`--k: ${k}`}><b>{name}</b><span>{detail}</span></span>
                    ))}
                  </span>
                )}
              </span>
              <span class="cap">
                <span class="name">
                  {p.name}
                  {p.href && <span class="out" aria-hidden="true">↗</span>}
                </span>
                <span class="where">{p.where}</span>
              </span>
              <span class="text">{p.text}</span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .work {
    background: var(--bluewood);
  }

  .picks {
    display: grid;
    gap: 48px 28px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Every product gets the same frame: the work is the picture */
  .shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: #2b3349;
    container-type: inline-size;
  }

  .shot :global(img) {
    display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .shot--site :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  a.card:hover .shot--site :global(img) {
    transform: scale(1.025);
  }

  /* Phones peek up from the bottom edge, big enough to read */
  .shot--phone,
  .shot--gym {
    display: flex;
    justify-content: center;
  }

  .shot--phone {
    background: #e9ebf6;
  }

  .shot--phone :global(img) {
    width: 46%;
    height: auto;
    margin-top: 6%;
    border-radius: 4.5cqw 4.5cqw 0 0;
  }

  /* Quantified Gym has no site to show, so it's a drawing of today's
     workout in the app */
  .shot--gym {
    background: #dfe5f5;
  }

  .gym {
    display: block;
    align-self: flex-start;
    width: 46%;
    margin-top: 6%;
    padding: 4cqw 3.2cqw 8cqw;
    border: 1.6cqw solid #1b2133;
    border-bottom: 0;
    border-radius: 6cqw 6cqw 0 0;
    background: #fff;
  }

  .gym__top {
    display: block;
    margin-bottom: 2.6cqw;
    font: 700 3.4cqw var(--font-body);
    color: #1b2234;
  }

  .ex {
    position: relative;
    display: grid;
    gap: 0.4cqw;
    margin-bottom: 1.8cqw;
    padding: 1.9cqw 7cqw 1.9cqw 2.2cqw;
    border: 1px solid #e3e7f0;
    border-radius: 1.6cqw;
  }

  .ex b {
    font-size: 2.9cqw;
    color: #1b2234;
  }

  .ex span {
    font-size: 2.4cqw;
    color: #6b7390;
  }

  /* Each set ticks off as the card scrolls into view */
  .ex::after {
    content: '';
    position: absolute;
    right: 2.4cqw;
    top: 50%;
    width: 3cqw;
    height: 3cqw;
    margin-top: -1.5cqw;
    border-radius: 50%;
    background: #6f9bff;
  }

  .shot--reader {
    display: grid;
    place-items: center;
    background: #e8e2d4;
  }

  .page {
    display: block;
    width: 80%;
    padding: 4.7cqw 5.8cqw;
    border-radius: 1.6cqw;
    background: #f6f1e7;
    font: 3.7cqw/1.7 Georgia, 'Times New Roman', serif;
    color: #3b3a36;
  }

  .page__top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 2cqw;
    font: 2.6cqw var(--font-body);
    color: #8b867b;
  }

  /* The phrase being narrated. The highlight is a background strip so it
     can sweep along the phrase, line by line. */
  mark {
    border-radius: 2px;
    background: linear-gradient(rgb(55 194 180 / 0.3), rgb(55 194 180 / 0.3)) 0 0 / 100% 100% no-repeat;
    color: inherit;
  }

  .cap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 16px;
  }

  .name {
    font: 700 19px var(--font-body);
    color: var(--ink);
    transition: color 0.2s;
  }

  a.card:hover .name,
  a.card:focus-visible .name {
    color: var(--accent);
  }

  /* Live sites get a small arrow out on hover, so it's clear the card
     leaves this site */
  .out {
    display: inline-block;
    margin-left: 6px;
    font-weight: 400;
    /* the arrow's fallback font is taller; keep it from raising the line */
    line-height: 0;
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.2s, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  a.card:hover .out,
  a.card:focus-visible .out {
    opacity: 1;
    transform: none;
  }

  .where {
    font: 700 11px var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .text {
    display: block;
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Scroll choreography: each card rises in as it enters, a beat behind the
     one beside it; the reader's highlight sweeps and the gym sets tick off */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .picks li {
        --rise: 40px;
        animation: fade-rise linear both;
        animation-timeline: view();
        animation-range: entry calc(var(--c, 0) * 10%) cover calc(25% + var(--c, 0) * 5%);
      }
      mark {
        animation: sweep linear both;
        animation-timeline: view();
        animation-range: cover 35% cover 60%;
      }
      .ex::after {
        animation: tick linear both;
        animation-timeline: view();
        animation-range: cover calc(35% + var(--k) * 6%) cover calc(39% + var(--k) * 6%);
      }
    }
  }

  @keyframes sweep {
    from {
      background-size: 0 100%;
    }
  }

  @keyframes tick {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @media (min-width: 640px) and (max-width: 899px) {
    .picks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .picks li:nth-child(2n) {
      --c: 1;
    }
  }

  @media (min-width: 900px) {
    .picks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .picks li:nth-child(3n + 2) {
      --c: 1;
    }
    .picks li:nth-child(3n) {
      --c: 2;
    }
  }
</style>
