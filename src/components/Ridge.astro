---
/*
  A low-poly mountain edge where a section rises into the one above it,
  drawn in the section's own colour with subtle facets.

  The ridge line is generated from `seed`, and published on the element
  (data-ridge, x as a fraction of the width, y in px from the top) so the fox
  can run along the actual ridge.
*/
interface Props {
  color: string;
  seed: number;
  height?: number;
}
const { color, seed, height = 72 } = Astro.props;

function rand(s: number) {
  return () => {
    s = (s * 1664525 + 1013904223) % 4294967296;
    return s / 4294967296;
  };
}
const r = rand(seed);
const n = 16;
// Alternate peaks and saddles so it reads as a range, never a zigzag of teeth
const pts: [number, number][] = [];
for (let i = 0; i <= n; i++) {
  const x = i / n + (i > 0 && i < n ? (r() - 0.5) * 0.035 : 0);
  const peak = i % 2 === 0;
  const y = peak ? 8 + r() * (height * 0.45) : height * 0.55 + r() * (height * 0.3);
  pts.push([x, Math.min(height - 6, y)]);
}
const W = 1000;
const line = pts.map(([x, y]) => `${(x * W).toFixed(1)},${y.toFixed(1)}`).join(' ');
// Facets: from each ridge point down to a point along the base
const facets = pts.slice(0, -1).map(([x, y], i) => {
  const [x2, y2] = pts[i + 1];
  const bx = ((x + x2) / 2) * W + (r() - 0.5) * 40;
  const light = i % 2 === 0;
  return {
    d: `${(x * W).toFixed(1)},${y.toFixed(1)} ${(x2 * W).toFixed(1)},${y2.toFixed(1)} ${bx.toFixed(1)},${height}`,
    tone: light ? 'rgba(255,255,255,0.035)' : 'rgba(0,0,0,0.07)',
  };
});
const data = pts.map(([x, y]) => `${x.toFixed(4)},${y.toFixed(1)}`).join(' ');
---

<div class="ridge" aria-hidden="true" style={`--h: ${height}px`}>
  <div class="ridge__line" data-ridge={data}>
  <svg viewBox={`0 0 ${W} ${height}`} preserveAspectRatio="none" width="100%" height={height}>
    <polygon points={`0,${height} ${line} ${W},${height}`} fill={color}></polygon>
    {facets.map((f) => <polygon points={f.d} fill={f.tone}></polygon>)}
  </svg>
  </div>
</div>

<style>
  .ridge {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--h) * -1 + 1px);
    height: var(--h);
    pointer-events: none;
    overflow: hidden;
  }

  /* Never narrower than 1100px: on a phone it shows a centred stretch of the
     same ridge rather than squeezing every peak into a tooth */
  .ridge__line {
    position: absolute;
    top: 0;
    left: min(0px, 50% - 550px);
    width: max(100%, 1100px);
    height: 100%;
  }

  .ridge svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
