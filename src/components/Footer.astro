---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <a href="/" aria-label="Rodney Cumming, home">
      <img src="/images/logo.svg" alt="" width="33" height="33" />
    </a>
    <p>Made by Rodney Cumming, {year}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    background: var(--dark-mirage);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 50px;
  }

  @media (min-width: 768px) {
    .footer__inner {
      flex-direction: row;
      gap: 30px;
      padding: 100px;
    }
  }

  p {
    color: var(--alto);
    font-size: 16px;
    line-height: 2rem;
    text-align: center;
  }
</style>
