---
/*
  A small live demo of a product, laid over the corner of its screenshot:
  plans sorting (SmartCompare), a quote decoding (Stoicism Now), an audit
  scoring (SEO Lamp), a card crossing the board (Quantified Habits). They
  play only while on screen (Projects.astro drives them) and sit still in
  their finished state with reduced motion. Figures are illustrative.
*/
interface Props {
  kind: 'plans' | 'quote' | 'audit' | 'board';
}
const { kind } = Astro.props;

const plans = [
  ['Prepay 20GB', 25],
  ['Endless 40GB', 39],
  ['Monthly 30GB', 32],
  ['Prepay 25GB', 29],
];
const scores = [
  ['Performance', 97],
  ['Accessibility', 100],
  ['Best practices', 96],
  ['SEO', 100],
];
const checks = ['Title length', 'Image alt text', 'Canonical URL'];
---

<div class:list={['demo', `demo--${kind}`]} data-demo={kind} aria-hidden="true">
  {kind === 'plans' && (
    <>
      <p class="demo__title">20GB+ <span>· cheapest first</span></p>
      <ol class="plans">
        {plans.map(([name, price], i) => (
          <li data-price={price} style={`--y: ${i}`}>
            <span>{name}</span>
            <b>${price}<small>/mo</small></b>
            <i style={`--w: ${(Number(price) / 40) * 100}%`}></i>
          </li>
        ))}
      </ol>
    </>
  )}

  {kind === 'quote' && (
    <>
      <p class="demo__title">Quote of the day</p>
      <p class="quote" data-quotes={JSON.stringify([
        ['No longer talk at all about the kind of man that a good man ought to be, but be such.', 'Marcus Aurelius, Meditations 10.16'],
        ['We are more often frightened than hurt; and we suffer more from imagination than from reality.', 'Seneca, Letters 13'],
      ])}>
        No longer talk at all about the kind of man that a good man ought to be, but be such.
      </p>
      <p class="quote__by">Marcus Aurelius, Meditations 10.16</p>
    </>
  )}

  {kind === 'audit' && (
    <>
      <p class="demo__title">Site audit</p>
      <div class="rings">
        {scores.map(([label, value]) => (
          <div class="ring" style={`--v: ${Number(value) / 100}`}>
            <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15" pathLength="1"></circle><circle cx="18" cy="18" r="15" pathLength="1"></circle></svg>
            <b data-to={value}>{value}</b>
            <small>{label}</small>
          </div>
        ))}
      </div>
      <ul class="checks">
        {checks.map((c, i) => (
          <li style={`--i: ${i}`}><i></i>{c}</li>
        ))}
      </ul>
    </>
  )}

  {kind === 'board' && (
    <div class="board">
      <p class="col"><span>Ready</span></p>
      <p class="col"><span>Doing</span></p>
      <p class="col"><span>Done</span></p>
      <p class="task task--still" style="--c: 1; --r: 1">Write project brief</p>
      <p class="task task--still" style="--c: 2; --r: 1">Pay power bill</p>
      <p class="task task--move" style="--c: 2; --r: 0">Morning run<small>Habit · 31 days</small></p>
    </div>
  )}
</div>

<style>
  .demo {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    width: 236px;
    padding: 14px 14px 12px;
    border: 1px solid rgb(27 34 52 / 0.12);
    border-radius: 14px;
    background: #fff;
    color: #1b2234;
    font-family: var(--font-body);
  }

  .demo__title {
    font: 700 12px var(--font-body);
    color: #1b2234;
  }

  .demo__title span {
    font-weight: 400;
    color: #6b7390;
  }

  /* SmartCompare: plans sort themselves, cheapest rising to the top */
  .plans {
    position: relative;
    height: 128px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .plans li {
    position: absolute;
    inset: 0 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 8px;
    padding: 5px 8px 7px;
    border-radius: 8px;
    font-size: 11.5px;
    transform: translateY(calc(var(--y) * 32px));
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1), background-color 0.6s;
  }

  .plans li b {
    font-size: 12px;
  }

  .plans li small {
    font-weight: 400;
    color: #6b7390;
  }

  .plans li i {
    grid-column: 1 / -1;
    height: 3px;
    border-radius: 3px;
    background: #e3e7f0;
    position: relative;
  }

  .plans li i::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border-radius: 3px;
    background: #b9c1d8;
    transition: background-color 0.6s;
  }

  .plans li.best {
    background: #e7f6ef;
  }

  .plans li.best i::after {
    background: #2fae78;
  }

  /* Stoicism Now: a quote decodes from scrambled letters */
  .demo--quote {
    width: 250px;
  }

  .quote {
    min-height: 66px;
    margin-top: 8px;
    font: 600 13px/1.45 Georgia, 'Times New Roman', serif;
    color: #2b3270;
  }

  .quote__by {
    margin-top: 8px;
    font-size: 10.5px;
    color: #6b7390;
    transition: opacity 0.5s;
  }

  .demo.is-scrambling .quote__by {
    opacity: 0;
  }

  /* SEO Lamp: scores sweep up, checks turn from failing to passing */
  .demo--audit {
    width: 262px;
  }

  .rings {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-top: 10px;
  }

  .ring {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 4px;
  }

  .ring svg {
    width: 44px;
    height: 44px;
    transform: rotate(-90deg);
  }

  .ring circle {
    fill: none;
    stroke-width: 3.2;
    stroke: #e8eaf0;
  }

  .ring circle + circle {
    stroke: #1aa260;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--v));
    transition: stroke-dashoffset 1.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ring b {
    position: absolute;
    top: 13px;
    font-size: 12px;
    color: #12814c;
  }

  .ring small {
    font-size: 8.5px;
    color: #6b7390;
    text-align: center;
    line-height: 1.2;
  }

  .checks {
    display: grid;
    gap: 6px;
    margin: 12px 0 0;
    padding: 10px 0 0;
    border-top: 1px solid #eef0f5;
    list-style: none;
    font-size: 11.5px;
  }

  .checks li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .checks i {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #1aa260;
    transition: background-color 0.4s;
  }

  .checks i::after {
    content: '';
    position: absolute;
    left: 4.5px;
    top: 2.5px;
    width: 3px;
    height: 6px;
    border: solid #fff;
    border-width: 0 1.6px 1.6px 0;
    transform: rotate(45deg);
  }

  /* Reset state while a run plays: rings empty, checks failing */
  .demo.is-reset .ring circle + circle {
    stroke-dashoffset: 1;
    transition: none;
  }

  .checks li.fail i {
    background: #e5484d;
    transition: none;
  }

  .checks li.fail i::after {
    border: 0;
    width: 7px;
    height: 1.6px;
    left: 3.5px;
    top: 6.2px;
    background: #fff;
    transform: none;
  }

  /* Quantified Habits: a card crosses the board */
  .demo--board {
    width: 270px;
    padding: 10px;
  }

  .board {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto 46px 46px;
    gap: 6px;
  }

  .col {
    grid-row: 1;
    font: 700 10px var(--font-body);
    letter-spacing: 0.04em;
    color: #6b7390;
  }

  .col::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 50%;
    background: #c7ccd8;
  }

  .col:nth-child(2)::before {
    background: #f5a524;
  }

  .col:nth-child(3)::before {
    background: #1aa260;
  }

  .task {
    grid-row: 2;
    grid-column: 1;
    margin: 0;
    padding: 6px 7px;
    border: 1px solid #e3e7f0;
    border-radius: 7px;
    background: #fff;
    font: 700 10.5px/1.3 var(--font-body);
  }

  .task small {
    display: block;
    font-weight: 400;
    font-size: 9px;
    color: #ff6a3d;
  }

  .task--still {
    grid-column: calc(var(--c) + 1);
    grid-row: calc(var(--r) + 2);
    color: #4a5270;
  }

  .task--move {
    position: relative;
    z-index: 1;
    transform: translateX(calc(var(--col, 0) * (100% + 6px)));
    transition: transform 0.85s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .task--move.is-lifting {
    animation: lift 0.85s ease-in-out;
  }

  @keyframes lift {
    40% {
      rotate: -3deg;
      scale: 1.05;
    }
  }

  /* In the smaller cards the demo sits smaller, so the real site still shows */
  :global(.card:not(.lead):not(.tall)) .demo {
    scale: 0.74;
    transform-origin: 100% 100%;
    right: 10px;
    bottom: 10px;
  }

  @media (max-width: 699px) {
    .demo {
      right: 10px;
      bottom: 10px;
      scale: 0.86;
      transform-origin: 100% 100%;
    }
  }
</style>
