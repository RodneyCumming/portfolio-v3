---
import { Picture } from 'astro:assets';
import mountainsBack from '../assets/mountains-back.png';
---

<!--
  Same art and layout as the 2020 site. The old version scrolled the whole page
  inside a 3D "perspective" container; this keeps the same layer speeds but
  drives them from the normal page scroll with CSS scroll-driven animations,
  so scrolling, the scrollbar and back/forward position all behave natively.
  --lag is how far behind the page each layer falls: 0.75 moves at a quarter
  of scroll speed, 0 moves with the page.
-->
<section class="hero" aria-labelledby="hero-name">
  <div class="layer sky" style="--lag: 0.75">
    <div class="sky__box">
      <div class="heading">
        <img class="cloud cloud--right" src="/images/cloud.svg" alt="" width="222" height="55" />
        <h1 id="hero-name" class="name">RODNEY CUMMING</h1>
        <p class="role">Developer</p>
        <img class="cloud cloud--left" src="/images/cloud.svg" alt="" width="222" height="55" />
      </div>
    </div>
  </div>

  <!-- Each layer is a wrapper (parallax) around its art (intro), so the two
       animations never fight over the same element -->
  <div class="layer range range--1" style="--lag: 0.6; --i: 1">
    <Picture
      class="art"
      src={mountainsBack}
      formats={['avif', 'webp']}
      width={3000}
      height={455}
      alt=""
      loading="eager"
      fetchpriority="high"
      sizes="3000px"
    />
  </div>
  <div class="layer range range--2" style="--lag: 0.5; --i: 2">
    <img class="art" src="/images/mountains-2.svg" alt="" width="3000" height="455" fetchpriority="high" />
  </div>
  <div class="layer range range--3" style="--lag: 0.333; --i: 3">
    <img class="art" src="/images/mountains-3.svg" alt="" width="3000" height="455" fetchpriority="high" />
  </div>
  <div class="range--4" style="--i: 4">
    <img class="art" src="/images/mountains-4.svg" alt="" width="3000" height="200" fetchpriority="high" />
  </div>
</section>

<!--
  Intro: the scene stays hidden only until its images and fonts are decoded
  (or 1.2 s, whichever comes first), then comes in back to front in one smooth
  pass. That avoids the old pop-in where layers arrived one by one. It plays
  once per visit; later page views show the hero straight away.
-->
<script is:inline>
  (function () {
    var d = document.documentElement;
    if (!d.classList.contains('intro')) return;
    var go = function () {
      if (d.classList.contains('intro-go')) return;
      requestAnimationFrame(function () {
        d.classList.add('intro-go');
      });
    };
    var imgs = [].slice.call(document.querySelectorAll('.hero img'));
    var ready = imgs.map(function (img) {
      return img.decode ? img.decode().catch(function () {}) : Promise.resolve();
    });
    if (document.fonts) ready.push(document.fonts.ready);
    Promise.all(ready).then(go);
    setTimeout(go, 1200);
  })();
</script>

<style>
  .hero {
    position: relative;
    /* The front range sits in the flow; everything after it scrolls normally */
    padding-top: 450px;
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: 650px;
    }
  }

  .layer {
    position: absolute;
    left: 50%;
    margin-left: -1500px;
    width: 3000px;
    will-change: transform;
  }

  .sky {
    top: 0;
  }

  .sky__box {
    height: 850px;
    background: var(--jagged-ice);
    box-shadow: inset 0 0 400px -150px #000;
    /* Inset shadow on the visible width only, like the old 101vw box */
    width: 101vw;
    margin: 0 auto;
    position: relative;
  }

  .heading {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding-top: 160px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .heading {
      padding-top: 250px;
    }
  }

  .name {
    margin: 0 20px;
    font-family: var(--font-display);
    font-weight: 700;
    /* Fits a phone's width instead of running off the edge */
    font-size: clamp(36px, 12vw, 110px);
    line-height: 0.82;
    color: #00c2e6;
    background-image: url('/images/hero-text-bg-static.svg');
    background-size: 500px;
    background-position: center;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .role {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 5px;
    margin-top: 4px;
    color: var(--fountain-blue);
  }

  @media (min-width: 768px) {
    .role {
      font-size: 26px;
    }
  }

  .cloud {
    position: absolute;
    height: 55px;
    width: auto;
  }

  .cloud--right {
    top: 220px;
    right: -300px;
  }

  .cloud--left {
    bottom: 0;
    left: -300px;
  }

  .range {
    height: 455px;
  }

  .range--1 {
    top: 235px;
  }
  .range--2 {
    top: 238px;
  }
  .range--3 {
    top: 320px;
  }

  @media (min-width: 768px) {
    .range--1 {
      top: 435px;
    }
    .range--2 {
      top: 438px;
    }
    .range--3 {
      top: 520px;
    }
  }

  .range--4 {
    position: relative;
    width: 3000px;
    height: 200px;
    margin-left: calc(50% - 1500px);
  }

  /* Parallax. Unsupported browsers get the same scene, standing still. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .layer {
        animation: lag linear both;
      }
      /* Kept in a separate rule: if the minifier folds animation-timeline
         into the animation shorthand, Chrome drops the whole declaration. */
      .hero .layer {
        animation-timeline: scroll(root block);
        animation-range: 0 1000px;
      }
    }
  }

  @keyframes lag {
    to {
      transform: translateY(calc(var(--lag) * 1000px));
    }
  }

  .art {
    display: block;
    width: 3000px;
    height: 100%;
  }

  /* Intro, back to front. Hidden only while html has .intro but not yet
     .intro-go; with no JavaScript neither class is set, so it simply shows. */
  :global(html.intro:not(.intro-go)) .art,
  :global(html.intro:not(.intro-go)) .name,
  :global(html.intro:not(.intro-go)) .role,
  :global(html.intro:not(.intro-go)) .cloud {
    opacity: 0;
  }

  :global(html.intro-go) .art {
    animation: intro-rise 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 1) * 90ms);
  }
  .range--1 .art {
    --rise: 30px;
  }
  .range--2 .art {
    --rise: 50px;
  }
  .range--3 .art {
    --rise: 70px;
  }
  .range--4 .art {
    --rise: 90px;
  }

  :global(html.intro-go) .name {
    animation: intro-focus 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
  }
  :global(html.intro-go) .role {
    animation: intro-fade 1s ease-out 0.7s both;
  }
  /* Clouds glide side to side, level, for as long as the page is open. The
     glide moves `transform` and the intro moves `translate`, so the two add
     together and the glide picks up seamlessly where the intro drift ends. */
  @media (prefers-reduced-motion: no-preference) {
    .cloud--right {
      animation: glide-a 9s ease-in-out infinite alternate;
    }
    .cloud--left {
      animation: glide-b 11s ease-in-out -3s infinite alternate;
    }
    :global(html.intro-go) .cloud--right {
      animation:
        intro-drift 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both,
        glide-a 9s ease-in-out infinite alternate;
      --from: 120px;
    }
    :global(html.intro-go) .cloud--left {
      animation:
        intro-drift 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both,
        glide-b 11s ease-in-out -3s infinite alternate;
      --from: -120px;
    }
  }

  @keyframes glide-a {
    to {
      transform: translateX(-70px);
    }
  }
  @keyframes glide-b {
    to {
      transform: translateX(80px);
    }
  }

  @keyframes intro-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes intro-rise {
    from {
      opacity: 0;
      translate: 0 var(--rise, 40px);
    }
  }
  @keyframes intro-focus {
    from {
      opacity: 0;
      filter: blur(8px);
      scale: 0.97;
    }
  }
  @keyframes intro-drift {
    from {
      opacity: 0;
      translate: var(--from) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.intro-go) .art,
    :global(html.intro-go) .name,
    :global(html.intro-go) .role,
    :global(html.intro-go) .cloud {
      animation: intro-fade 0.4s ease-out both;
    }
  }
</style>
