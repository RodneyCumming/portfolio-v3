---
import { Picture, getImage } from 'astro:assets';
import mountainsBack from '../assets/mountains-back.png';
// The back range itself is the mask, so the late light only falls on it
// (same size and crop as the art, so the edges line up exactly)
const backMask = await getImage({ src: mountainsBack, format: 'png', width: 3000, height: 455 });
---

<!--
  Same art and layout as the 2020 site. The old version scrolled the whole page
  inside a 3D "perspective" container; this keeps the same layer speeds but
  drives them from the normal page scroll with CSS scroll-driven animations,
  so scrolling, the scrollbar and back/forward position all behave natively.
  --lag is how far behind the page each layer falls: 0.75 moves at a quarter
  of scroll speed, 0 moves with the page.
-->
<section class="hero" aria-labelledby="hero-name">
  <div class="layer sky" style="--lag: 0.75">
    <div class="sky__box">
      <!-- Late-afternoon light: a soft warm glow low behind the right-hand peak -->
      <div class="glow" aria-hidden="true"></div>
      <!-- A few birds crossing the sky: a pair, and one on its own -->
      <div class="birds" aria-hidden="true">
        <span class="bird" style="--y: 118px; --d: 34s; --delay: -6s; --s: 0.9; --flap: 0.55s"><i></i></span>
        <span class="bird" style="--y: 146px; --d: 36s; --delay: -8s; --s: 0.7; --flap: 0.48s"><i></i></span>
        <span class="bird" style="--y: 196px; --d: 52s; --delay: -30s; --s: 0.55; --flap: 0.44s"><i></i></span>
      </div>
      <div class="heading">
        <img class="cloud cloud--right" src="/images/cloud.svg" alt="" width="222" height="55" />
        <div class="name-wrap"><h1 id="hero-name" class="name" data-text="RODNEY CUMMING">RODNEY CUMMING</h1></div>
        <p class="role">Developer</p>
        <img class="cloud cloud--left" src="/images/cloud.svg" alt="" width="222" height="55" />
      </div>
    </div>
  </div>

  <!-- Morphing facets: Chrome and Edge paint the name with a live mesh
       (public/worklets/facets.js); other browsers keep the faceted texture. -->
  <script is:inline>
    if (window.CSS && CSS.paintWorklet) {
      CSS.paintWorklet.addModule('/worklets/facets.js').then(function () {
        document.documentElement.classList.add('facets-live');
      });
      // Stop repainting the mesh while the hero is off screen
      document.addEventListener('DOMContentLoaded', function () {
        var hero = document.querySelector('.hero');
        if (!hero || !window.IntersectionObserver) return;
        new IntersectionObserver(function (e) {
          document.documentElement.classList.toggle('hero-away', !e[0].isIntersecting);
        }).observe(hero);
      });
    }
  </script>

  <!-- Each layer is a wrapper (parallax) around its art (intro), so the two
       animations never fight over the same element -->
  <div class="layer range range--1" style="--lag: 0.6; --i: 1">
    <Picture
      class="art"
      src={mountainsBack}
      formats={['avif', 'webp']}
      width={3000}
      height={455}
      alt=""
      loading="eager"
      fetchpriority="high"
      sizes="3000px"
    />
    <!-- The same light catching the snow on the side facing the glow -->
    <div class="art snowlight" aria-hidden="true" style={`--mask: url(${backMask.src})`}></div>
  </div>
  <div class="layer range range--2" style="--lag: 0.5; --i: 2">
    <img class="art" src="/images/mountains-2.svg" alt="" width="3000" height="455" fetchpriority="high" />
  </div>
  <div class="layer range range--3" style="--lag: 0.333; --i: 3">
    <img class="art" src="/images/mountains-3.svg" alt="" width="3000" height="455" fetchpriority="high" />
  </div>
  <div class="range--4" style="--i: 4">
    <img class="art" src="/images/mountains-4.svg" alt="" width="3000" height="200" fetchpriority="high" />
  </div>
</section>

<!--
  Intro: the scene stays hidden only until its images and fonts are decoded
  (or 1.2 s, whichever comes first), then comes in back to front in one smooth
  pass. That avoids the old pop-in where layers arrived one by one. It plays
  once per visit; later page views show the hero straight away.
-->
<script is:inline>
  (function () {
    var d = document.documentElement;
    if (!d.classList.contains('intro')) return;
    var go = function () {
      if (d.classList.contains('intro-go')) return;
      requestAnimationFrame(function () {
        d.classList.add('intro-go');
      });
    };
    var imgs = [].slice.call(document.querySelectorAll('.hero img'));
    var ready = imgs.map(function (img) {
      return img.decode ? img.decode().catch(function () {}) : Promise.resolve();
    });
    if (document.fonts) ready.push(document.fonts.ready);
    Promise.all(ready).then(go);
    setTimeout(go, 1200);
  })();
</script>

<style>
  .hero {
    position: relative;
    /* The front range sits in the flow; everything after it scrolls normally */
    padding-top: 450px;
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: 650px;
    }
  }

  .layer {
    position: absolute;
    left: 50%;
    margin-left: -1500px;
    width: 3000px;
    will-change: transform;
  }

  .sky {
    top: 0;
  }

  .sky__box {
    height: 850px;
    /* Pale blue overhead, warming just a little toward the horizon */
    background: linear-gradient(#c6d8e5, #cbdce7 140px, #dcdcd6 327px, #ecd8c0 463px);
    box-shadow: inset 0 0 400px -150px #000;
    /* Inset shadow on the visible width only, like the old 101vw box */
    width: 101vw;
    margin: 0 auto;
    position: relative;
  }

  @media (min-width: 768px) {
    .sky__box {
      background: linear-gradient(#c6d8e5, #cbdce7 340px, #dcdcd6 527px, #ecd8c0 663px);
    }
  }

  .glow {
    position: absolute;
    left: calc(50% + 40px);
    top: 230px;
    width: 560px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(255 228 180 / 0.75),
      rgb(255 222 175 / 0.35) 45%,
      rgb(255 220 170 / 0)
    );
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .glow {
      top: 430px;
    }
  }

  .snowlight {
    position: absolute;
    top: 0;
    left: 0;
    background: linear-gradient(
      90deg,
      rgb(255 190 130 / 0.1),
      rgb(255 200 140 / 0.32) 58%,
      rgb(255 190 130 / 0.1)
    );
    mix-blend-mode: soft-light;
    -webkit-mask: var(--mask) 0 0 / 100% 100% no-repeat;
    mask: var(--mask) 0 0 / 100% 100% no-repeat;
    pointer-events: none;
  }

  .birds {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bird {
    position: absolute;
    top: var(--y);
    left: 0;
    width: 48px;
    height: 44px;
    scale: var(--s);
    translate: calc(101vw + 60px) 0;
  }

  .bird i {
    display: block;
    width: 100%;
    height: 100%;
    background: url('/images/bird-sprite.svg') 0 0 / 384px 44px no-repeat;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bird {
      animation:
        fly var(--d) linear var(--delay) infinite,
        glide 5s ease-in-out var(--delay) infinite alternate;
    }
    .bird i {
      animation: flap var(--flap) steps(8) infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .birds {
      display: none;
    }
  }

  @keyframes fly {
    to {
      translate: -80px 0;
    }
  }

  /* A gentle rise and fall as they go */
  @keyframes glide {
    from {
      transform: translateY(-6px);
    }
    to {
      transform: translateY(8px);
    }
  }

  @keyframes flap {
    to {
      background-position: -384px 0;
    }
  }

  .heading {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding-top: 160px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .heading {
      padding-top: 250px;
    }
  }

  .name {
    margin: 0 20px;
    font-family: var(--font-display);
    font-weight: 700;
    /* Fits a phone's width instead of running off the edge */
    font-size: clamp(36px, 12vw, 110px);
    line-height: 0.82;
    color: #00c2e6;
    background-image: url('/images/hero-text-bg-static.svg');
    background-size: 500px;
    background-position: center;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
  }

  /* Two more copies of the facet pattern, clipped to the same letters at other
     scales and blend modes. As they move against each other the triangles
     merge and re-form, so the pattern changes instead of just sliding. */
  .name::before,
  .name::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    background-image: url('/images/hero-text-bg-static.svg');
    background-position: center;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    pointer-events: none;
  }

  .name::before {
    background-size: 340px;
    mix-blend-mode: multiply;
    opacity: 0.5;
  }

  .name::after {
    background-size: 760px;
    mix-blend-mode: screen;
    opacity: 0.45;
  }

  .role {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 5px;
    margin-top: 4px;
    color: var(--fountain-blue);
  }

  @media (min-width: 768px) {
    .role {
      font-size: 26px;
    }
  }

  .cloud {
    position: absolute;
    height: 55px;
    width: auto;
    /* A touch of the warm light */
    filter: sepia(0.18) saturate(1.4);
  }

  .cloud--right {
    top: 220px;
    right: -300px;
  }

  .cloud--left {
    bottom: 0;
    left: -300px;
  }

  .range {
    height: 455px;
  }

  .range--1 {
    top: 235px;
  }
  .range--2 {
    top: 238px;
  }
  /* The old site set this layer back in its 3D parallax without scaling it
     up again, so it showed at two-thirds size: a distant row of small peaks
     between the back ranges and the front one. Same size and place here. */
  .range--3 {
    top: 374px;
  }
  .range--3 .art {
    width: 2000px;
    height: 303px;
    /* The old 3D origin sat right of centre, so the row sits a little left */
    margin-left: calc(250px + 8.333vw);
  }

  @media (min-width: 768px) {
    .range--1 {
      top: 435px;
    }
    .range--2 {
      top: 438px;
    }
    .range--3 {
      top: 531px;
    }
  }

  .range--4 {
    position: relative;
    width: 3000px;
    height: 200px;
    margin-left: calc(50% - 1500px);
  }

  /* Parallax. Unsupported browsers get the same scene, standing still. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .layer {
        animation: lag linear both;
      }
      /* Kept in a separate rule: if the minifier folds animation-timeline
         into the animation shorthand, Chrome drops the whole declaration. */
      .hero .layer {
        animation-timeline: scroll(root block);
        animation-range: 0 1000px;
      }
    }
  }

  /* Each facet layer wanders its own zig-zag path and changes scale as you
     scroll, tied to the scrollbar, so the pattern shifts unpredictably. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .name {
        animation: facets-a linear both;
      }
      .name::before {
        animation: facets-b linear both;
      }
      .name::after {
        animation: facets-c linear both;
      }
      /* Separate rules so the minifier can't fold the timeline into the shorthand */
      .heading .name,
      .heading .name::before,
      .heading .name::after {
        animation-timeline: scroll(root block);
        animation-range: 0 700px;
      }
    }
  }

  /* Live facets: the triangles themselves drift and change shape over time,
     and morph faster while you scroll. */
  @property --facet-t {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
  @property --facet-s {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  :global(html.facets-live) .name {
    background-image: paint(facets);
    background-size: 100% 100%;
    background-position: 0 0;
  }

  :global(html.facets-live) .name::before,
  :global(html.facets-live) .name::after {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.facets-live) .name {
      animation:
        facet-clock 3600s linear infinite,
        facet-scroll linear both;
    }
    /* Separate rule so the minifier can't fold the timelines into the shorthand */
    :global(html.facets-live) .heading .name {
      animation-timeline: auto, scroll(root block);
      animation-range: normal, 0 700px;
    }
  }

  :global(html.hero-away) .name {
    animation-play-state: paused;
  }

  @keyframes facet-clock {
    to {
      --facet-t: 3600;
    }
  }

  @keyframes facet-scroll {
    to {
      --facet-s: 1;
    }
  }

  @keyframes facets-a {
    25% {
      background-position: calc(50% - 120px) calc(50% + 40px);
      background-size: 540px;
    }
    55% {
      background-position: calc(50% + 70px) calc(50% + 110px);
      background-size: 470px;
    }
    80% {
      background-position: calc(50% - 200px) calc(50% + 30px);
      background-size: 560px;
    }
    100% {
      background-position: calc(50% - 90px) calc(50% + 160px);
      background-size: 500px;
    }
  }

  @keyframes facets-b {
    20% {
      background-position: calc(50% + 150px) calc(50% - 60px);
      background-size: 400px;
    }
    50% {
      background-position: calc(50% - 80px) calc(50% + 90px);
      background-size: 300px;
    }
    75% {
      background-position: calc(50% + 210px) calc(50% + 20px);
      background-size: 380px;
    }
    100% {
      background-position: calc(50% + 40px) calc(50% - 140px);
      background-size: 330px;
    }
  }

  @keyframes facets-c {
    30% {
      background-position: calc(50% - 60px) calc(50% - 120px);
      background-size: 680px;
    }
    60% {
      background-position: calc(50% + 180px) calc(50% + 60px);
      background-size: 820px;
    }
    100% {
      background-position: calc(50% - 150px) calc(50% + 200px);
      background-size: 720px;
    }
  }

  @keyframes lag {
    to {
      transform: translateY(calc(var(--lag) * 1000px));
    }
  }

  .art {
    display: block;
    width: 3000px;
    height: 100%;
  }

  /* Intro, back to front. Hidden only while html has .intro but not yet
     .intro-go; with no JavaScript neither class is set, so it simply shows. */
  :global(html.intro:not(.intro-go)) .art,
  :global(html.intro:not(.intro-go)) .birds,
  :global(html.intro:not(.intro-go)) .glow,
  :global(html.intro:not(.intro-go)) .name-wrap,
  :global(html.intro:not(.intro-go)) .role,
  :global(html.intro:not(.intro-go)) .cloud {
    opacity: 0;
  }

  :global(html.intro-go) .art {
    animation: intro-rise 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 1) * 90ms);
  }
  .range--1 .art {
    --rise: 30px;
  }
  .range--2 .art {
    --rise: 50px;
  }
  .range--3 .art {
    --rise: 70px;
  }
  .range--4 .art {
    --rise: 90px;
  }

  :global(html.intro-go) .name-wrap {
    animation: intro-focus 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
  }
  :global(html.intro-go) .birds {
    animation: intro-fade 1.6s ease-out 0.9s both;
  }
  :global(html.intro-go) .glow {
    animation: intro-fade 2.4s ease-out 0.6s both;
  }
  :global(html.intro-go) .role {
    animation: intro-fade 1s ease-out 0.7s both;
  }
  /* Clouds glide side to side, level, for as long as the page is open. The
     glide moves `transform` and the intro moves `translate`, so the two add
     together and the glide picks up seamlessly where the intro drift ends. */
  @media (prefers-reduced-motion: no-preference) {
    .cloud--right {
      animation: glide-a 9s ease-in-out infinite alternate;
    }
    .cloud--left {
      animation: glide-b 11s ease-in-out -3s infinite alternate;
    }
    :global(html.intro-go) .cloud--right {
      animation:
        intro-drift 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both,
        glide-a 9s ease-in-out infinite alternate;
      --from: 120px;
    }
    :global(html.intro-go) .cloud--left {
      animation:
        intro-drift 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both,
        glide-b 11s ease-in-out -3s infinite alternate;
      --from: -120px;
    }
  }

  @keyframes glide-a {
    to {
      transform: translateX(-70px);
    }
  }
  @keyframes glide-b {
    to {
      transform: translateX(80px);
    }
  }

  @keyframes intro-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes intro-rise {
    from {
      opacity: 0;
      translate: 0 var(--rise, 40px);
    }
  }
  @keyframes intro-focus {
    from {
      opacity: 0;
      filter: blur(8px);
      scale: 0.97;
    }
  }
  @keyframes intro-drift {
    from {
      opacity: 0;
      translate: var(--from) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.intro-go) .art,
    :global(html.intro-go) .name-wrap,
    :global(html.intro-go) .role,
    :global(html.intro-go) .cloud {
      animation: intro-fade 0.4s ease-out both;
    }
  }
</style>
