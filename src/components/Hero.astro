---
import { Picture } from 'astro:assets';
import mountainsBack from '../assets/mountains-back.png';
---

<!--
  Same art and layout as the 2020 site. The old version scrolled the whole page
  inside a 3D "perspective" container; this keeps the same layer speeds but
  drives them from the normal page scroll with CSS scroll-driven animations,
  so scrolling, the scrollbar and back/forward position all behave natively.
  --lag is how far behind the page each layer falls: 0.75 moves at a quarter
  of scroll speed, 0 moves with the page.
-->
<section class="hero" aria-labelledby="hero-name">
  <div class="layer sky" style="--lag: 0.75">
    <div class="sky__box">
      <div class="heading">
        <img class="cloud cloud--right" src="/images/cloud.svg" alt="" width="222" height="55" />
        <h1 id="hero-name" class="name">RODNEY CUMMING</h1>
        <p class="role">Developer</p>
        <img class="cloud cloud--left" src="/images/cloud.svg" alt="" width="222" height="55" />
      </div>
    </div>
  </div>

  <Picture
    class="layer range range--1"
    style="--lag: 0.6"
    src={mountainsBack}
    formats={['avif', 'webp']}
    width={3000}
    height={455}
    alt=""
    loading="eager"
    fetchpriority="high"
    sizes="3000px"
  />
  <img class="layer range range--2" style="--lag: 0.5" src="/images/mountains-2.svg" alt="" width="3000" height="455" />
  <img class="layer range range--3" style="--lag: 0.333" src="/images/mountains-3.svg" alt="" width="3000" height="455" />
  <img class="range--4" src="/images/mountains-4.svg" alt="" width="3000" height="200" />
</section>

<style>
  .hero {
    position: relative;
    /* The front range sits in the flow; everything after it scrolls normally */
    padding-top: 450px;
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: 650px;
    }
  }

  .layer {
    position: absolute;
    left: 50%;
    margin-left: -1500px;
    width: 3000px;
    will-change: transform;
  }

  .sky {
    top: 0;
  }

  .sky__box {
    height: 850px;
    background: var(--jagged-ice);
    box-shadow: inset 0 0 400px -150px #000;
    /* Inset shadow on the visible width only, like the old 101vw box */
    width: 101vw;
    margin: 0 auto;
    position: relative;
  }

  .heading {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding-top: 160px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .heading {
      padding-top: 250px;
    }
  }

  .name {
    margin: 0 20px;
    font-family: var(--font-display);
    font-weight: 700;
    /* Fits a phone's width instead of running off the edge */
    font-size: clamp(36px, 12vw, 110px);
    line-height: 0.82;
    color: #00c2e6;
    background-image: url('/images/hero-text-bg-static.svg');
    background-size: 500px;
    background-position: center;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .role {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 5px;
    margin-top: 4px;
    color: var(--fountain-blue);
  }

  @media (min-width: 768px) {
    .role {
      font-size: 26px;
    }
  }

  .cloud {
    position: absolute;
    height: 55px;
    width: auto;
  }

  .cloud--right {
    top: 220px;
    right: -300px;
  }

  .cloud--left {
    bottom: 0;
    left: -300px;
  }

  .range {
    height: 455px;
  }

  .range--1 {
    top: 235px;
  }
  .range--2 {
    top: 238px;
  }
  .range--3 {
    top: 320px;
  }

  @media (min-width: 768px) {
    .range--1 {
      top: 435px;
    }
    .range--2 {
      top: 438px;
    }
    .range--3 {
      top: 520px;
    }
  }

  .range--4 {
    position: relative;
    width: 3000px;
    height: 200px;
    margin-left: calc(50% - 1500px);
  }

  /* Parallax. Unsupported browsers get the same scene, standing still. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .layer {
        animation: lag linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 1000px;
      }
    }
  }

  @keyframes lag {
    to {
      transform: translateY(calc(var(--lag) * 1000px));
    }
  }

  /* Gentle entrance: clouds drift in, the name fades up. Short, never blocking. */
  @media (prefers-reduced-motion: no-preference) {
    .cloud--right {
      animation: drift-left 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .cloud--left {
      animation: drift-right 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .name,
    .role {
      animation: fade-up 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .role {
      animation-delay: 0.1s;
    }
  }

  @keyframes drift-left {
    from {
      translate: 100px 0;
      opacity: 0;
    }
  }
  @keyframes drift-right {
    from {
      translate: -100px 0;
      opacity: 0;
    }
  }
  @keyframes fade-up {
    from {
      translate: 0 12px;
      opacity: 0;
    }
  }
</style>
