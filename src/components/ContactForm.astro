<!-- Netlify Forms reads this form from the built HTML; no backend or script needed -->
<section class="form-section" id="message" aria-labelledby="form-heading">
  <form class="form" name="contact" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="contact" />
    <p class="visually-hidden">
      <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>
    <div class="form__fields">
      <h2 id="form-heading">SEND MESSAGE</h2>
      <label class="visually-hidden" for="name">Name</label>
      <input id="name" name="name" type="text" placeholder="Name..." autocomplete="name" required />
      <label class="visually-hidden" for="email">Email</label>
      <input id="email" name="email" type="email" placeholder="Email..." autocomplete="email" required />
      <label class="visually-hidden" for="message-text">Message</label>
      <textarea id="message-text" name="message" rows="8" placeholder="Message..." required></textarea>
    </div>
    <button class="form__send" type="submit">
      <img src="/images/icons/sendIcon2.svg" alt="" width="60" height="40" />
      <span class="visually-hidden">Send message</span>
    </button>
  </form>
</section>

<style>
  .form-section {
    position: relative;
    z-index: 1;
    background: #203344;
    padding: 20px;
  }

  @media (min-width: 768px) {
    .form-section {
      padding: 40px;
    }
  }

  @media (min-width: 1025px) {
    .form-section {
      padding: 100px;
    }
  }

  .form {
    width: min(100%, 1400px);
    margin: auto;
    display: flex;
    flex-direction: column;
    background: var(--light-mirage);
    border-radius: 10px;
    overflow: hidden;
  }

  @media (min-width: 1025px) {
    .form {
      width: 70vw;
      flex-direction: row;
    }
  }

  .form__fields {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding: 40px 20px 10px;
    flex: 1;
  }

  @media (min-width: 768px) {
    .form__fields {
      padding: 60px 60px 40px;
    }
  }

  @media (min-width: 1025px) {
    .form__fields {
      padding: 70px 110px;
    }
  }

  h2 {
    width: 100%;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    color: #fff;
  }

  input,
  textarea {
    width: 100%;
    padding: 10px 15px;
    border: 1px solid #2a3e53;
    border-radius: 6px;
    background: #2a3e53;
    color: #fff;
    font: 18px/1.6 var(--font-body);
    transition: background 0.2s;
  }

  @media (min-width: 1025px) {
    input {
      width: calc(50% - 10px);
    }
  }

  input:hover,
  textarea:hover {
    background: #304863;
  }

  input:focus,
  textarea:focus {
    outline: none;
    background: #29506f;
  }

  textarea {
    resize: vertical;
  }

  .form__send {
    display: grid;
    place-items: center;
