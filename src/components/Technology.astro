---
import {
  siReact,
  siNextdotjs,
  siTypescript,
  siJavascript,
  siCss3,
  siMui,
  siNodedotjs,
  siSupabase,
  siPostgresql,
  siStripe,
  siVercel,
  siCapacitor,
  siIonic,
  siSwift,
  siSqlite,
  siVite,
  siJest,
  siGit,
  siFigma,
} from 'simple-icons';

type Tool = { label: string; icon: { path: string }; core?: boolean };
const groups: { id: string; name: string; note: string; tools: Tool[] }[] = [
  {
    id: 'Frontend',
    name: 'Frontend',
    note: "What I've worked with most.",
    tools: [
      { label: 'React', icon: siReact, core: true },
      { label: 'Next.js', icon: siNextdotjs, core: true },
      { label: 'TypeScript', icon: siTypescript, core: true },
      { label: 'JavaScript', icon: siJavascript },
      { label: 'CSS & CSS Modules', icon: siCss3 },
      { label: 'MUI', icon: siMui },
    ],
  },
  {
    id: 'Backend',
    name: 'Backend & data',
    note: 'The server side of my products.',
    tools: [
      { label: 'Node.js', icon: siNodedotjs },
      { label: 'Supabase', icon: siSupabase },
      { label: 'PostgreSQL', icon: siPostgresql },
      { label: 'Stripe', icon: siStripe },
      { label: 'Vercel', icon: siVercel },
    ],
  },
  {
    id: 'Mobile',
    name: 'Mobile',
    note: 'React on phones, and native.',
    tools: [
      { label: 'Capacitor', icon: siCapacitor },
      { label: 'Ionic', icon: siIonic },
      { label: 'Swift', icon: siSwift },
      { label: 'SQLite', icon: siSqlite },
    ],
  },
  {
    id: 'Tools',
    name: 'Tools',
    note: 'Building, testing and shipping.',
    tools: [
      { label: 'Vite', icon: siVite },
      { label: 'Jest', icon: siJest },
      { label: 'Git', icon: siGit },
      { label: 'Figma', icon: siFigma },
    ],
  },
];
const filters = ['All', ...groups.map((g) => g.id)];
---

<section class="section tech" aria-labelledby="tech-heading">
  <div class="section__inner">
    <div class="head-row">
      <div>
        <p class="eyebrow"><span class="num" style="--to: 2" aria-hidden="true"></span>&nbsp; Technology</p>
        <h2 id="tech-heading" class="section__heading is-left"><span class="heading-text">TECHNOLOGY</span></h2>
        <p class="sub">React at the centre, <em>everything around it.</em></p>
      </div>
      <!-- Plain radio buttons; CSS :has() does the filtering, no JavaScript -->
      <fieldset class="seg">
        <span class="seg__pill" aria-hidden="true"></span>
        <legend class="visually-hidden">Show</legend>
        {filters.map((f, i) => (
          <label>
            <input type="radio" name="tech-filter" value={f} checked={i === 0} />
            <span>{f}</span>
          </label>
        ))}
      </fieldset>
    </div>

    <div class="groups" data-live>
      {groups.map((g, i) => (
        <div class="group" data-group={g.id} style={`--g: ${i}`}>
          <h3>{g.name}</h3>
          <p>{g.note}</p>
          <ul role="list">
            {g.tools.map((t, j) => (
              <li class:list={{ core: t.core }} style={`--j: ${j}`}>
                <svg class:list={{ loop: t.label === 'React', spin: t.label === 'React' }} viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={t.icon.path} /></svg>
                {t.label === 'TypeScript' ? <span class="typed" style={`--n: ${t.label.length}`}>{t.label}</span> : t.label}
                {t.core && <small>Core</small>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  // The selected filter has a pill that slides between the options
  (function () {
    var seg = document.querySelector('.tech .seg');
    var pill = seg && seg.querySelector('.seg__pill');
    if (!pill) return;
    function move() {
      var on = seg.querySelector('input:checked + span');
      if (!on) return;
      var a = on.getBoundingClientRect(), b = seg.getBoundingClientRect();
      pill.style.width = a.width + 'px';
      pill.style.height = a.height + 'px';
      pill.style.transform = 'translate(' + (a.left - b.left - seg.clientLeft) + 'px,' + (a.top - b.top - seg.clientTop) + 'px)';
    }
    seg.classList.add('has-pill');
    move();
    seg.addEventListener('change', move);
    addEventListener('resize', move);
    document.fonts && document.fonts.ready.then(move);
  })();
</script>

<style>
  .tech {
    background: var(--bluewood);
  }

  .seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 5px;
    border: 0;
    border-radius: 24px;
    background: #252c42;
  }

  .seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .seg span {
    display: block;
    padding: 10px 18px;
    border-radius: 999px;
    font: 700 13px var(--font-body);
    letter-spacing: 0.06em;
    color: #9aa3bd;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }

  .seg label:hover span {
    color: var(--ink);
  }

  .seg input:checked + span {
    background: var(--ink);
    color: #1b2234;
  }

  .seg {
    position: relative;
  }

  .seg label {
    position: relative;
    z-index: 1;
  }

  .seg__pill {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 999px;
    background: var(--ink);
    opacity: 0;
    transition:
      transform 0.45s cubic-bezier(0.3, 1.25, 0.5, 1),
      width 0.45s cubic-bezier(0.3, 1.25, 0.5, 1);
  }

  .seg.has-pill .seg__pill {
    opacity: 1;
  }

  .seg.has-pill input:checked + span {
    background: transparent;
    transition: color 0.3s 0.1s;
  }

  /* React's atom turns slowly */
  .spin {
    animation: spin 16s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  /* TypeScript types itself out the first time the groups are seen */
  .typed {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.live-ready) .groups:not(.was-seen) .typed {
      clip-path: inset(0 100% 0 0);
    }
    .groups.was-seen .typed {
      animation: type 1.1s steps(var(--n)) 0.8s backwards;
    }
  }

  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .seg input:focus-visible + span {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .groups {
    display: grid;
    gap: 20px;
    margin-top: 40px;
  }

  .group {
    padding: 26px 24px 28px;
    border: 1px solid rgb(255 255 255 / 0.05);
    border-radius: 18px;
    background: var(--panel);
  }

  h3 {
    font: 700 18px var(--font-body);
    color: var(--ink);
  }

  .group p {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: #dde2f0;
  }

  li svg {
    flex: none;
    fill: #aeb7cf;
  }

  li.core {
    color: #fff;
  }

  li.core svg {
    fill: var(--accent);
  }

  small {
    margin-left: auto;
    font: 700 10px var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tech:has(input[value='Frontend']:checked) .group:not([data-group='Frontend']),
  .tech:has(input[value='Backend']:checked) .group:not([data-group='Backend']),
  .tech:has(input[value='Mobile']:checked) .group:not([data-group='Mobile']),
  .tech:has(input[value='Tools']:checked) .group:not([data-group='Tools']) {
    display: none;
  }

  /* Scroll choreography: the groups surface from depth one after another,
     then their tools fill in from the top */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .groups {
        view-timeline: --groups block;
      }
      .group {
        animation: surface linear both;
      }
      .tech .group {
        animation-timeline: --groups;
        animation-range: entry calc(var(--g) * 12%) cover calc(28% + var(--g) * 6%);
      }
      li {
        --rise: 12px;
        animation: fade-rise linear both;
      }
      .group li {
        animation-timeline: --groups;
        animation-range: cover calc(18% + var(--g) * 6% + var(--j) * 3%) cover calc(30% + var(--g) * 6% + var(--j) * 3%);
      }
      li.core small {
        animation: core-glow linear both;
      }
      .group li.core small {
        animation-timeline: --groups;
        animation-range: cover 35% cover 50%;
      }
    }
  }

  @keyframes surface {
    from {
      opacity: 0;
      transform: perspective(900px) translateY(70px) rotateX(18deg) scale(0.92);
    }
  }

  @keyframes core-glow {
    from {
      color: transparent;
      letter-spacing: 0.4em;
    }
  }

  @media (min-width: 600px) {
    .groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1025px) {
    .groups {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
