---
const links = [
  { href: '/', label: 'HOME' },
  { href: '/portfolio', label: 'PORTFOLIO' },
  { href: '/contact', label: 'CONTACT' },
];
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="nav">
  <a class="nav__logo" href="/" aria-label="Rodney Cumming, home">
    <img src="/images/logo.svg" alt="" width="20" height="20" />
  </a>

  <nav class="nav__links" aria-label="Main">
    {links.map((l) => (
      <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>

  <!-- Phone menu: the Popover API opens and closes it with no script -->
  <button class="nav__menu-button" popovertarget="menu" aria-label="Open menu">
    <img src="/images/icons/menu.svg" alt="" width="24" height="24" />
  </button>
  <div id="menu" class="menu" popover>
    <button class="menu__close" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu">
      <img src="/images/icons/close.svg" alt="" width="30" height="30" />
    </button>
    <nav class="menu__links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: absolute;
    z-index: 100;
    inset: 0 0 auto;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--cloud-burst);
    box-shadow: 0 6px 7px 2px rgba(0, 0, 0, 0.2);
    view-transition-name: nav;
  }

  .nav__logo {
    margin-left: 20px;
    padding: 20px;
  }

  @media (min-width: 768px) {
    .nav__logo {
      margin-left: 30px;
    }
  }

  .nav__links {
    display: none;
    height: 100%;
    margin-right: 50px;
  }

  .nav__links a,
  .menu__links a {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-body);
  }

  .nav__links a {
    display: flex;
    align-items: center;
    padding: 0 30px;
    font-size: 14px;
    transition: background 0.2s;
  }

  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    background: var(--light-mirage);
  }

  .nav__menu-button {
    margin-right: 30px;
    padding: 8px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
    .nav__menu-button {
      display: none;
    }
  }

  .menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(26, 40, 53, 0.95);
    opacity: 0;
    transition: opacity 0.2s, display 0.2s allow-discrete, overlay 0.2s allow-discrete;
  }

  .menu:popover-open {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
  }

  @starting-style {
    .menu:popover-open {
      opacity: 0;
    }
  }

  .menu__close {
    position: absolute;
    top: 15px;
    right: 30px;
    padding: 8px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .menu__links a {
    font-size: clamp(30px, 10vw, 50px);
    font-weight: 700;
    line-height: 1.8;
  }

  .menu__links a:hover,
  .menu__links a[aria-current='page'] {
    color: var(--cyan);
  }
</style>
