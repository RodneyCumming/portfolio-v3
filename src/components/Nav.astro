---
const links = [
  { href: '/', label: 'HOME' },
  { href: '/portfolio', label: 'PORTFOLIO' },
];
const contact = { href: '/contact', label: 'GET IN TOUCH' };
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
// On the home page the nav sits on the light sky; elsewhere on a dark header
const theme = path === '/' ? 'sky' : 'dark';
---

<!-- Sits at the top of the page and scrolls away with it (not fixed or sticky) -->
<header class="nav" data-theme={theme}>
  <a class="nav__logo" href="/" aria-label="Rodney Cumming, home">
    <img src="/images/logo.svg" alt="" width="24" height="24" />
  </a>

  <nav class="nav__links" aria-label="Main">
    {links.map((l) => (
      <a class="pill" href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
    ))}
    <a class="cta" href={contact.href} aria-current={path === contact.href ? 'page' : undefined}>{contact.label}</a>
  </nav>

  <!-- Phone menu: the Popover API opens and closes it with no script -->
  <button class="nav__menu-button" popovertarget="menu" aria-label="Open menu">
    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
  </button>
  <div id="menu" class="menu" popover>
    <button class="menu__close" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu">
      <img src="/images/icons/close.svg" alt="" width="30" height="30" />
    </button>
    <nav class="menu__links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="cta" href={contact.href} aria-current={path === contact.href ? 'page' : undefined}>{contact.label}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    --ink: #203244;
    --ring: #203244;
    position: absolute;
    z-index: 100;
    inset: 0 0 auto;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 max(24px, 4vw);
    view-transition-name: nav;
  }

  .nav[data-theme='dark'] {
    --ink: #d8e0e9;
    --ring: rgba(255, 255, 255, 0.4);
  }

  .nav__logo {
    display: block;
    padding: 8px;
    margin-left: -8px;
  }

  /* The logo is pale blue; on the sky it is darkened to navy to stay legible */
  .nav[data-theme='sky'] .nav__logo img {
    filter: brightness(0.32) saturate(1.5);
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 6px;
  }

  .nav__links a {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 999px;
  }

  /* Hover: a soft fill eases in behind the link; no outlines flashing on */
  .pill {
    --fill: rgba(255, 255, 255, 0);
    color: var(--ink);
    background-color: var(--fill);
    transition:
      background-color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav[data-theme='sky'] .pill:hover {
    --fill: rgba(255, 255, 255, 0.5);
  }

  .nav[data-theme='dark'] .pill:hover {
    --fill: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .pill[aria-current='page'] {
    box-shadow: inset 0 0 0 1.5px var(--ring);
  }

  .nav[data-theme='dark'] .pill[aria-current='page'] {
    color: #fff;
  }

  /* Filled with the same faceted cyan as the name. On hover the facets glide
     across, as if catching the light, and the button lifts a pixel. */
  .cta {
    margin-left: 14px;
    color: #fff;
    background: url('/images/hero-text-bg-static.svg') 0 50% / 260px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    text-shadow: 0 1px 2px rgba(0, 51, 68, 0.55);
    transition:
      background-position 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      translate 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cta:hover {
    background-position: -90px 50%;
    translate: 0 -1px;
  }

  .cta:active {
    translate: 0 0;
    transition-duration: 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta,
    .pill {
      transition: none;
    }
  }

  .nav__menu-button {
    margin-right: -8px;
    padding: 8px;
    color: var(--ink);
    background: none;
    border: 0;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
    .nav__menu-button {
      display: none;
    }
  }

  .menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(26, 40, 53, 0.96);
    opacity: 0;
    transition: opacity 0.2s, display 0.2s allow-discrete, overlay 0.2s allow-discrete;
  }

  .menu:popover-open {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
  }

  @starting-style {
    .menu:popover-open {
      opacity: 0;
    }
  }

  .menu__close {
    position: absolute;
    top: 25px;
    right: max(16px, 4vw);
    padding: 8px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .menu__links a {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(26px, 8vw, 40px);
    letter-spacing: 0.08em;
  }

  .menu__links a[aria-current='page'] {
    color: var(--cyan);
  }

  .menu__links .cta {
    margin: 18px 0 0;
    padding: 16px 32px;
    border-radius: 999px;
    font-size: 18px;
    letter-spacing: 0.18em;
  }
</style>
