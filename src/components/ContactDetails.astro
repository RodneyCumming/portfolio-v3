---
import { Image } from 'astro:assets';
import phone from '../assets/phone.png';
import email from '../assets/email.png';

interface Props {
  heading: string;
  body?: string;
  background?: string;
}
const { heading, body, background = 'var(--bluewood)' } = Astro.props;
---

<section class="section contact" style={`background: ${background}`} aria-labelledby="contact-heading" id="call-or-email">
  <div class="section__inner">
    <div class="reveal">
      <h2 id="contact-heading" class="section__heading"><span class="heading-text">{heading}</span></h2>
      {body && <p class="section__body">{body}</p>}
    </div>
    <ul class="methods reveal" role="list">
      <li>
        <a href="tel:+64276359269">
          <Image src={phone} alt="" width={110} loading="lazy" />
          <span>+64 27 635 9269</span>
        </a>
      </li>
      <li>
        <a href="mailto:rodneycumming@gmail.com">
          <Image src={email} alt="" width={110} loading="lazy" />
          <span>RODNEYCUMMING@GMAIL.COM</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .methods {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px 80px;
    margin: 60px 0 0;
    padding: 0;
    list-style: none;
  }

  .methods a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: var(--pigeon-post);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 18px;
  }

  .methods img {
    height: 70px;
    width: auto;
    filter: grayscale(0.4);
    transform: scale(0.9);
    transition: transform 0.3s, filter 0.3s;
  }

  .methods a:hover img {
    filter: grayscale(0);
    transform: scale(1);
  }

  @media (min-width: 1025px) {
    .methods img {
      height: 110px;
    }
    .methods a {
      font-size: 22px;
    }
  }
</style>
