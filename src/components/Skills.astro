---
import Ridge from './Ridge.astro';
import { categories, skills } from '../data/skills';
const filters = ['All', ...categories];
---

<section class="section skills" aria-labelledby="skills-heading">
  <Ridge color="var(--bluewood)" seed={11} />
  <div class="section__inner">
    <div class="reveal">
      <h2 id="skills-heading" class="section__heading"><span class="heading-text">TECHNOLOGY</span></h2>
      <p class="section__body">
        Below are some of the technologies I've learnt to use. My core strengths are CSS, JavaScript and React.
      </p>
    </div>

    <!-- The filter is plain radio buttons styled as pills; CSS :has() does the
         filtering, so it works with no JavaScript at all. -->
    <fieldset class="filters reveal">
      <legend class="visually-hidden">Show technologies for</legend>
      {filters.map((f, i) => (
        <label class="filter">
          <input type="radio" name="skill-filter" value={f} checked={i === 0} />
          <span>{f}</span>
        </label>
      ))}
    </fieldset>

    <ul class="grid reveal" role="list">
      {skills.map((s, i) => (
        <li class="skill" data-category={s.category} style={`view-transition-name: skill-${i}`}>
          <img src={`/images/icons/${s.icon}.svg`} alt="" width="40" height="40" loading="lazy" />
          <span>{s.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .skills {
    background: var(--bluewood);
  }

  .section__body {
    margin-bottom: 40px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px 20px;
    margin: 0 0 30px;
    padding: 0;
    border: 0;
  }

  .filter input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .filter span {
    display: inline-block;
    padding: 8px 20px;
    border: 1px solid #9ba4c4;
    border-radius: 20px;
    color: #a3acca;
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .filter:hover span,
  .filter input:checked + span {
    border-color: #bbc8f3;
    color: #bbc8f3;
  }

  .filter input:focus-visible + span {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 15px;
    color: #fff;
    font-size: 15px;
  }

  @media (min-width: 768px) {
    .skill {
      padding: 20px;
    }
  }

  .skill img {
    height: 30px;
    width: auto;
    filter: saturate(0) brightness(1.5);
  }

  @media (min-width: 768px) {
    .skill img {
      height: 40px;
    }
  }

  .skill img,
  .skill span {
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.25s;
  }

  .skill:hover img {
    transform: translateY(-3px);
    filter: saturate(0) brightness(2.2) drop-shadow(0 4px 6px rgba(0, 0, 0, 0.35));
  }

  /* Without JavaScript the radios filter on their own (:has); with it, the
     script applies the filter inside a view transition so the tiles glide. */
  .skills:not(.js-filter):has(input[value='Frontend']:checked) .skill:not([data-category='Frontend']),
  .skills:not(.js-filter):has(input[value='Backend']:checked) .skill:not([data-category='Backend']),
  .skills:not(.js-filter):has(input[value='Tools']:checked) .skill:not([data-category='Tools']),
  .skills[data-show='Frontend'] .skill:not([data-category='Frontend']),
  .skills[data-show='Backend'] .skill:not([data-category='Backend']),
  .skills[data-show='Tools'] .skill:not([data-category='Tools']) {
    display: none;
  }

  .skill {
    view-transition-class: skill;
  }

  ::view-transition-group(*.skill) {
    animation-duration: 0.45s;
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
</style>

<script is:inline>
  (function () {
    var sec = document.querySelector('.skills');
    if (!sec || !document.startViewTransition) return;
    var reduce = matchMedia('(prefers-reduced-motion: reduce)');
    sec.classList.add('js-filter');
    sec.addEventListener(
      'change',
      function (e) {
        if (e.target.name !== 'skill-filter') return;
        var v = e.target.value;
        // Only names the tiles on screen get, so the transition stays cheap
        if (reduce.matches) {
          sec.dataset.show = v;
          return;
        }
        e.stopPropagation();
        var t = document.startViewTransition(function () {
          sec.dataset.show = v;
        });
        // Let the fox recalculate once the grid has its new layout
        t.updateCallbackDone.then(function () {
          document.dispatchEvent(new Event('change-skills'));
        });
      },
      true
    );
  })();
</script>
