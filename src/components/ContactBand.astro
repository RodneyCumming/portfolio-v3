---
const email = 'rodneycumming@gmail.com';
const github = 'https://github.com/RodneyCumming';
interface Props {
  /** Section number shown in the eyebrow (the home page numbers its sections) */
  number?: string;
  heading?: string;
}
const { number = '04', heading = 'CONTACT' } = Astro.props;
---

<section class="section contact" aria-labelledby="contact-heading" id="contact">
  <div class="section__inner">
    <div class="band" data-live>
      <div class="band__main">
        <p class="eyebrow">{number && <><span class="num" style={`--to: ${parseInt(number, 10)}`} aria-hidden="true"></span>&nbsp; </>}Contact</p>
        <h2 id="contact-heading" class="section__heading is-left"><span class="heading-text">{heading}</span></h2>
        <p class="sub">Working on something interesting? <em>Let's talk.</em></p>
        <div class="mail">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 6-10 7L2 6"></path></svg>
          <a class="typed" href={`mailto:${email}`} style={`--n: ${email.length}`}>{email}</a>
          <button type="button" data-copy={email}>Copy email</button>
          <svg class="plane" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
        </div>
        <p class="chips loop">
          <span><i class="dots" aria-hidden="true"><b></b><b></b><b></b></i>Replies within a day or two</span>
          <span><i class="pin" aria-hidden="true"><b></b><b></b></i>Based in New Zealand</span>
        </p>
      </div>

      <div class="band__side">
        <a class="tile" href={github} rel="noopener" style="--t: 0">
          <small>GitHub</small>
          <strong>RodneyCumming</strong>
          <span class="tile__text">Code for this site and some of my projects.</span>
          <span class="tile__link">Open GitHub →</span>
        </a>
        <div class="tile" style="--t: 1">
          <small>Local time</small>
          <span class="time-row">
            <svg class="clock" viewBox="0 0 40 40" aria-hidden="true">
              <circle cx="20" cy="20" r="18"></circle>
              <line class="h" x1="20" y1="20" x2="20" y2="11"></line>
              <line class="m" x1="20" y1="20" x2="20" y2="6"></line>
              <line class="s" x1="20" y1="22" x2="20" y2="5"></line>
              <circle class="hub" cx="20" cy="20" r="1.6"></circle>
            </svg>
            <strong data-nz-time>New Zealand</strong>
          </span>
          <span class="tile__text" data-nz-zone>New Zealand</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Copy the email address, with a moment of feedback on the button
    document.querySelectorAll('[data-copy]').forEach(function (b) {
      if (!navigator.clipboard) return b.remove();
      b.addEventListener('click', function () {
        navigator.clipboard.writeText(b.dataset.copy).then(function () {
          b.textContent = 'Copied';
          // A paper plane takes off from the button
          var plane = b.parentNode.querySelector('.plane');
          if (plane) {
            plane.classList.remove('fly');
            void plane.getBoundingClientRect();
            plane.classList.add('fly');
          }
          setTimeout(function () {
            b.textContent = 'Copy email';
          }, 1600);
        });
      });
    });

    // Rodney's local time, ticking
    var time = document.querySelector('[data-nz-time]');
    var zone = document.querySelector('[data-nz-zone]');
    if (!time || !window.Intl) return;
    var clock = new Intl.DateTimeFormat('en-NZ', { timeZone: 'Pacific/Auckland', hour: 'numeric', minute: '2-digit' });
    var tz = new Intl.DateTimeFormat('en-NZ', { timeZone: 'Pacific/Auckland', timeZoneName: 'short' });
    // The analogue hands, in New Zealand time
    var hm = new Intl.DateTimeFormat('en-GB', { timeZone: 'Pacific/Auckland', hour: 'numeric', minute: 'numeric', second: 'numeric', hourCycle: 'h23' });
    var face = document.querySelector('.clock');
    function hands(now) {
      if (!face) return;
      var p = hm.formatToParts(now).reduce(function (o, x) {
        o[x.type] = +x.value;
        return o;
      }, {});
      face.style.setProperty('--h', ((p.hour % 12) * 30 + p.minute * 0.5) + 'deg');
      face.style.setProperty('--m', (p.minute * 6 + p.second * 0.1) + 'deg');
      face.style.setProperty('--s0', -p.second + 's');
    }
    hands(new Date());
    function tick() {
      var now = new Date();
      hands(now);
      time.textContent = clock.format(now).toUpperCase();
      var name = tz.formatToParts(now).find(function (p) {
        return p.type === 'timeZoneName';
      });
      zone.textContent = 'New Zealand' + (name ? ' (' + name.value + ')' : '');
    }
    tick();
    setInterval(tick, 15000);
  })();
</script>

<style>
  .contact {
    background: var(--bluewood);
  }

  .band {
    display: grid;
    gap: 40px;
    padding: 48px 24px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: #232a3f;
  }

  .band .section__heading {
    font-size: clamp(64px, 16vw, 118px);
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    max-width: 560px;
    margin-top: 36px;
    padding: 8px 8px 8px 20px;
    border-radius: 14px;
    background: #fff;
    color: var(--bluewood);
  }

  .mail a {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    font: 700 18px var(--font-body);
    color: #1b2234;
    text-decoration: none;
  }

  .mail button {
    padding: 13px 20px;
    border: 0;
    border-radius: 10px;
    background: var(--bluewood);
    color: #fff;
    font: 700 15px var(--font-body);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .mail button:hover {
    background: var(--east-bay);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .chips span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border-radius: 999px;
    background: var(--bluewood);
    font-size: 14px;
    color: #c6cde2;
  }

  /* The email types itself in the first time the band is seen */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.live-ready) .band:not(.was-seen) .typed {
      clip-path: inset(0 100% 0 0);
    }
    .band.was-seen .typed {
      animation: type 1.4s steps(var(--n)) 0.5s backwards;
    }
  }

  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Copying sends a paper plane off along a curve */
  .mail {
    position: relative;
  }

  .plane {
    position: absolute;
    right: 30px;
    top: 8px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linejoin: round;
    opacity: 0;
    pointer-events: none;
    offset-path: path('M0 0 C 30 -10 50 -60 110 -90');
    offset-rotate: auto 45deg;
  }

  .plane.fly {
    animation: fly 1.1s cubic-bezier(0.4, 0, 0.6, 1) forwards;
  }

  @keyframes fly {
    0% {
      offset-distance: 0%;
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  /* Chips: typing dots, and a location pin with a ripple */
  .dots {
    display: inline-flex;
    gap: 3px;
  }

  .dots b {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    animation: dot 1.4s ease-in-out infinite;
  }

  .dots b:nth-child(2) {
    animation-delay: 0.18s;
  }

  .dots b:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes dot {
    0%,
    60%,
    100% {
      transform: none;
      opacity: 0.4;
    }
    30% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }

  .pin {
    position: relative;
    width: 10px;
    height: 10px;
  }

  .pin b {
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: var(--accent);
  }

  .pin b + b {
    inset: 1px;
    background: none;
    border: 1.5px solid var(--accent);
    animation: ripple 2.4s ease-out infinite;
  }

  @keyframes ripple {
    from {
      transform: scale(1);
      opacity: 0.9;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* A small analogue clock beside the time */
  .time-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
  }

  .time-row strong {
    margin-top: 0;
  }

  .clock {
    flex: none;
    width: 40px;
    height: 40px;
  }

  .clock circle {
    fill: none;
    stroke: rgb(255 255 255 / 0.25);
    stroke-width: 1.5;
  }

  .clock line {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: 20px 20px;
  }

  .clock .h {
    transform: rotate(var(--h, 0deg));
  }

  .clock .m {
    stroke-width: 1.5;
    transform: rotate(var(--m, 0deg));
  }

  .clock .s {
    stroke: var(--accent);
    stroke-width: 1;
    animation: sweep 60s linear infinite;
    animation-delay: var(--s0, 0s);
  }

  .clock .hub {
    fill: var(--accent);
    stroke: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .clock .s {
      animation: none;
    }
  }

  @keyframes sweep {
    to {
      transform: rotate(1turn);
    }
  }

  .band__side {
    display: grid;
    gap: 16px;
    align-content: center;
  }

  .tile {
    display: block;
    padding: 24px 26px;
    border-radius: 18px;
    background: var(--bluewood);
    color: #c6cde2;
    text-decoration: none;
  }

  a.tile {
    transition: background-color 0.2s;
  }

  a.tile:hover {
    background: #343d5c;
  }

  .tile small {
    font: 700 11px var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8792b3;
  }

  .tile strong {
    display: block;
    margin-top: 10px;
    font: 700 clamp(30px, 3.4vw, 46px) / 1 var(--font-display);
    letter-spacing: 0.5px;
    color: var(--ink);
  }

  .tile__text {
    display: block;
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  .tile__link {
    display: inline-block;
    margin-top: 12px;
    font: 700 15px var(--font-body);
    color: var(--accent);
  }

  .sub em {
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 2px no-repeat;
    padding-bottom: 2px;
  }

  /* Scroll choreography: the band opens out to full size, its parts rise
     in, and "Let's talk." underlines itself */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .band {
        animation: open-up linear both;
      }
      .contact .band {
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
      .band__main > *,
      .tile {
        animation: fade-rise linear both;
      }
      .contact .band__main > *,
      .contact .tile {
        animation-timeline: --band;
        animation-range: entry 40% cover 38%;
      }
      .contact .tile {
        animation-range: entry calc(50% + var(--t) * 15%) cover calc(40% + var(--t) * 5%);
      }
      .band {
        view-timeline: --band block;
      }
      .sub em {
        animation: underline linear both;
      }
      .contact .sub em {
        animation-timeline: --band;
        animation-range: cover 30% cover 48%;
      }
    }
  }

  @keyframes open-up {
    from {
      transform: scale(0.88);
      border-radius: 64px;
      opacity: 0.3;
    }
  }

  @keyframes underline {
    from {
      background-size: 0 2px;
    }
  }

  @media (min-width: 1025px) {
    .band {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 60px;
      align-items: center;
      padding: 96px 90px;
    }
  }
</style>
