---
const email = 'rodneycumming@gmail.com';
const github = 'https://github.com/RodneyCumming';
interface Props {
  /** Section number shown in the eyebrow (the home page numbers its sections) */
  number?: string;
  heading?: string;
}
const { number = '04', heading = 'CONTACT' } = Astro.props;
---

<section class="section contact" aria-labelledby="contact-heading" id="contact">
  <div class="section__inner">
    <div class="band">
      <div class="band__main">
        <p class="eyebrow">{number && <>{number}&nbsp; </>}Contact</p>
        <h2 id="contact-heading" class="section__heading is-left"><span class="heading-text">{heading}</span></h2>
        <p class="sub">Working on something interesting? <em>Let's talk.</em></p>
        <div class="mail">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 6-10 7L2 6"></path></svg>
          <a href={`mailto:${email}`}>{email}</a>
          <button type="button" data-copy={email}>Copy email</button>
        </div>
        <p class="chips"><span>Replies within a day or two</span><span>Based in New Zealand</span></p>
      </div>

      <div class="band__side">
        <a class="tile px" href={github} rel="noopener" style="--from: 60px; --to: -60px">
          <small>GitHub</small>
          <strong>RodneyCumming</strong>
          <span class="tile__text">Code for this site and some of my projects.</span>
          <span class="tile__link">Open GitHub →</span>
        </a>
        <div class="tile px" style="--from: 120px; --to: -120px">
          <small>Local time</small>
          <strong data-nz-time>New Zealand</strong>
          <span class="tile__text" data-nz-zone>New Zealand</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Copy the email address, with a moment of feedback on the button
    document.querySelectorAll('[data-copy]').forEach(function (b) {
      if (!navigator.clipboard) return b.remove();
      b.addEventListener('click', function () {
        navigator.clipboard.writeText(b.dataset.copy).then(function () {
          b.textContent = 'Copied';
          setTimeout(function () {
            b.textContent = 'Copy email';
          }, 1600);
        });
      });
    });

    // Rodney's local time, ticking
    var time = document.querySelector('[data-nz-time]');
    var zone = document.querySelector('[data-nz-zone]');
    if (!time || !window.Intl) return;
    var clock = new Intl.DateTimeFormat('en-NZ', { timeZone: 'Pacific/Auckland', hour: 'numeric', minute: '2-digit' });
    var tz = new Intl.DateTimeFormat('en-NZ', { timeZone: 'Pacific/Auckland', timeZoneName: 'short' });
    function tick() {
      var now = new Date();
      time.textContent = clock.format(now).toUpperCase();
      var name = tz.formatToParts(now).find(function (p) {
        return p.type === 'timeZoneName';
      });
      zone.textContent = 'New Zealand' + (name ? ' (' + name.value + ')' : '');
    }
    tick();
    setInterval(tick, 15000);
  })();
</script>

<style>
  .contact {
    background: var(--bluewood);
  }

  .band {
    display: grid;
    gap: 40px;
    padding: 48px 24px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: #232a3f;
  }

  .band .section__heading {
    font-size: clamp(64px, 16vw, 118px);
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    max-width: 560px;
    margin-top: 36px;
    padding: 8px 8px 8px 20px;
    border-radius: 14px;
    background: #fff;
    color: var(--bluewood);
  }

  .mail a {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    font: 700 18px var(--font-body);
    color: #1b2234;
    text-decoration: none;
  }

  .mail button {
    padding: 13px 20px;
    border: 0;
    border-radius: 10px;
    background: var(--bluewood);
    color: #fff;
    font: 700 15px var(--font-body);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .mail button:hover {
    background: var(--east-bay);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .chips span {
    padding: 9px 15px;
    border-radius: 999px;
    background: var(--bluewood);
    font-size: 14px;
    color: #c6cde2;
  }

  .band__side {
    display: grid;
    gap: 16px;
    align-content: center;
  }

  .tile {
    display: block;
    padding: 24px 26px;
    border-radius: 18px;
    background: var(--bluewood);
    color: #c6cde2;
    text-decoration: none;
  }

  a.tile {
    transition: background-color 0.2s;
  }

  a.tile:hover {
    background: #343d5c;
  }

  .tile small {
    font: 700 11px var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8792b3;
  }

  .tile strong {
    display: block;
    margin-top: 10px;
    font: 700 clamp(30px, 3.4vw, 46px) / 1 var(--font-display);
    letter-spacing: 0.5px;
    color: var(--ink);
  }

  .tile__text {
    display: block;
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  .tile__link {
    display: inline-block;
    margin-top: 12px;
    font: 700 15px var(--font-body);
    color: var(--accent);
  }

  @media (min-width: 1025px) {
    .band {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 60px;
      align-items: center;
      padding: 96px 90px;
    }
  }
</style>
