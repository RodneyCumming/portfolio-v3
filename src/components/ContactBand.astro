---
import Odo from './Odo.astro';
import { siGithub } from 'simple-icons';
const email = 'rodneycumming@gmail.com';
const github = 'https://github.com/RodneyCumming';
interface Props {
  /** Section number shown in the eyebrow (the home page numbers its sections) */
  number?: string;
  heading?: string;
}
const { number = '04', heading = 'CONTACT' } = Astro.props;
---

<section class="section contact" aria-labelledby="contact-heading" id="contact">
  <div class="section__inner">
    <div class="band" data-live>
      <div class="band__main">
        <p class="eyebrow" data-live>{number && <><Odo value={number} />&nbsp; </>}Contact</p>
        <h2 id="contact-heading" class="section__heading is-left"><span class="heading-text">{heading}</span></h2>
        <p class="sub">Working on something interesting? <em>Let's talk.</em></p>
        <div class="mail">
          <svg class="mail__icon draw" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" style="--dd: 0.4s"><rect x="2" y="4" width="20" height="16" rx="2" pathLength="1"></rect><path d="m22 6-10 7L2 6" pathLength="1"></path></svg>
          <a href={`mailto:${email}`}>{email}</a>
          <button type="button" data-copy={email}>Copy email</button>
        </div>
        <p class="chips">
          <span>Replies within a day or two</span>
          <span><i class="drop loop" aria-hidden="true"><b></b><i></i><i></i></i>Based in New Zealand</span>
        </p>
      </div>

      <div class="band__side">
        <a class="tile" href={github} rel="noopener" style="--t: 0">
          <svg class="tile__icon trace" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" style="--dd: 0.6s"><path d={siGithub.path} pathLength="1"></path></svg>
          <small>GitHub</small>
          <strong>RodneyCumming</strong>
          <span class="tile__text">Code for this site and some of my projects.</span>
          <span class="tile__link">Open GitHub →</span>
        </a>
        <div class="tile" style="--t: 1">
          <small>Local time</small>
          <strong data-nz-time>New Zealand</strong>
          <span class="tile__text" data-nz-zone>New Zealand</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Copy the email address; a ripple spreads out from the button
    document.querySelectorAll('[data-copy]').forEach(function (b) {
      if (!navigator.clipboard) return b.remove();
      b.addEventListener('click', function () {
        navigator.clipboard.writeText(b.dataset.copy).then(function () {
          b.textContent = 'Copied';
          b.classList.remove('ripple');
          void b.offsetWidth;
          b.classList.add('ripple');
          setTimeout(function () {
            b.textContent = 'Copy email';
          }, 1600);
        });
      });
    });

    // Rodney's local time on a mechanical counter: the digit reels roll
    // over as the minutes change
    var time = document.querySelector('[data-nz-time]');
    var zone = document.querySelector('[data-nz-zone]');
    if (!time || !window.Intl) return;
    var clock = new Intl.DateTimeFormat('en-NZ', { timeZone: 'Pacific/Auckland', hour: 'numeric', minute: '2-digit' });
    var tz = new Intl.DateTimeFormat('en-NZ', { timeZone: 'Pacific/Auckland', timeZoneName: 'short' });
    var reels = null;
    function draw(text) {
      var shape = text.replace(/\d/g, '0');
      if (!reels || reels.shape !== shape) {
        var html = '';
        for (var i = 0; i < text.length; i++) {
          var c = text[i];
          html += /\d/.test(c)
            ? '<span class="odo__col" style="--d: 0; --i: ' + i + '"><span class="odo__reel">' +
              '<i>0</i><i>1</i><i>2</i><i>3</i><i>4</i><i>5</i><i>6</i><i>7</i><i>8</i><i>9</i></span></span>'
            : '<span class="odo__sep">' + c + '</span>';
        }
        time.innerHTML = '<span class="odo" aria-hidden="true">' + html + '</span><span class="visually-hidden"></span>';
        reels = { shape: shape, cols: time.querySelectorAll('.odo__col, .odo__sep') };
        requestAnimationFrame(function () {
          draw(text);
        });
        return;
      }
      for (var k = 0; k < text.length; k++) {
        if (/\d/.test(text[k])) reels.cols[k].style.setProperty('--d', text[k]);
      }
      time.querySelector('.visually-hidden').textContent = text;
    }
    function tick() {
      var now = new Date();
      draw(clock.format(now).toUpperCase());
      var name = tz.formatToParts(now).find(function (p) {
        return p.type === 'timeZoneName';
      });
      zone.textContent = 'New Zealand' + (name ? ' (' + name.value + ')' : '');
    }
    tick();
    setInterval(tick, 10000);
  })();
</script>

<style>
  .contact {
    background: var(--bluewood);
  }

  .band {
    display: grid;
    gap: 40px;
    padding: 48px 24px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: #232a3f;
  }

  .band .section__heading {
    font-size: clamp(64px, 16vw, 118px);
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    max-width: 560px;
    margin-top: 36px;
    padding: 8px 8px 8px 20px;
    border-radius: 14px;
    background: #fff;
    color: var(--bluewood);
  }

  .mail a {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    font: 700 18px var(--font-body);
    color: #1b2234;
    text-decoration: none;
  }

  .mail button {
    padding: 13px 20px;
    border: 0;
    border-radius: 10px;
    background: var(--bluewood);
    color: #fff;
    font: 700 15px var(--font-body);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .mail button:hover {
    background: var(--east-bay);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .chips span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border-radius: 999px;
    background: var(--bluewood);
    font-size: 14px;
    color: #c6cde2;
  }

  /* Copying sends a ripple out from the button, like a drop in water */
  .mail button {
    position: relative;
  }

  .mail button::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1.5px solid var(--accent);
    opacity: 0;
    pointer-events: none;
  }

  .mail button.ripple::after {
    animation: button-ripple 0.9s ease-out;
  }

  @keyframes button-ripple {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.35, 1.8);
    }
  }

  .mail__icon :is(rect, path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Based in New Zealand: a drop falls and its ripple spreads */
  .drop {
    position: relative;
    width: 12px;
    height: 14px;
  }

  .drop b {
    position: absolute;
    left: 50%;
    top: 0;
    width: 4px;
    height: 6px;
    margin-left: -2px;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: var(--accent);
    animation: fall 4s cubic-bezier(0.5, 0, 1, 1) infinite;
  }

  .drop i {
    position: absolute;
    left: 50%;
    top: 75%;
    width: 8px;
    height: 3px;
    margin: -1.5px 0 0 -4px;
    border-radius: 50%;
    border: 1.2px solid var(--accent);
    opacity: 0;
    animation: ring 4s ease-out infinite;
  }

  .drop i + i {
    animation-delay: 0.45s;
  }

  @keyframes fall {
    0% {
      transform: translateY(-5px);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    26% {
      transform: translateY(6px);
      opacity: 1;
    }
    27%,
    100% {
      transform: translateY(6px);
      opacity: 0;
    }
  }

  @keyframes ring {
    0%,
    26% {
      transform: scale(0.4);
      opacity: 0;
    }
    30% {
      opacity: 0.9;
    }
    80%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .tile__icon {
    float: right;
    color: var(--accent);
    fill: var(--accent);
    overflow: visible;
  }

  .band__side {
    display: grid;
    gap: 16px;
    align-content: center;
  }

  .tile {
    display: block;
    padding: 24px 26px;
    border-radius: 18px;
    background: var(--bluewood);
    color: #c6cde2;
    text-decoration: none;
  }

  a.tile {
    transition: background-color 0.2s;
  }

  a.tile:hover {
    background: #343d5c;
  }

  .tile small {
    font: 700 11px var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8792b3;
  }

  .tile strong {
    display: block;
    margin-top: 10px;
    font: 700 clamp(30px, 3.4vw, 46px) / 1 var(--font-display);
    letter-spacing: 0.5px;
    color: var(--ink);
  }

  .tile__text {
    display: block;
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  .tile__link {
    display: inline-block;
    margin-top: 12px;
    font: 700 15px var(--font-body);
    color: var(--accent);
  }

  .sub em {
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 2px no-repeat;
    padding-bottom: 2px;
  }

  /* Scroll choreography: the band opens out to full size, its parts rise
     in, and "Let's talk." underlines itself */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .band {
        animation: open-up linear both;
      }
      .contact .band {
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
      .band__main > *,
      .tile {
        animation: fade-rise linear both;
      }
      .contact .band__main > *,
      .contact .tile {
        animation-timeline: --band;
        animation-range: entry 40% cover 38%;
      }
      .contact .tile {
        animation-range: entry calc(50% + var(--t) * 15%) cover calc(40% + var(--t) * 5%);
      }
      .band {
        view-timeline: --band block;
      }
      .sub em {
        animation: underline linear both;
      }
      .contact .sub em {
        animation-timeline: --band;
        animation-range: cover 30% cover 48%;
      }
    }
  }

  @keyframes open-up {
    from {
      transform: scale(0.88);
      border-radius: 64px;
      opacity: 0.3;
    }
  }

  @keyframes underline {
    from {
      background-size: 0 2px;
    }
  }

  @media (min-width: 1025px) {
    .band {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 60px;
      align-items: center;
      padding: 96px 90px;
    }
  }
</style>
