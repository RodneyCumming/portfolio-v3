---
// What Rodney is doing now. Update it when it changes.
const nowDate = 'November 2026';
const now = [
  ['Building', 'SmartCompare, so New Zealanders stop overpaying for their mobile plan'],
  ['Shipping', 'Whole-site audits for SEO Lamp'],
  ['Learning', 'Swift and SwiftUI, for the Immerse reader'],
  ['Based', 'New Zealand'],
];
// The intro lights up word by word as it scrolls through the view
const intro =
  "Hey, I'm Rodney, a senior frontend developer in New Zealand. I've spent more than ten years building fast, polished interfaces, and lately I've been designing, building and shipping my own products end to end.";
const words = intro.split(' ');
const steps = [
  ['Fast by default', 'Static where it can be, light on JavaScript, quick on a slow phone.'],
  ['Details that feel right', 'Spacing, motion and states that make an interface feel considered.'],
  ['Shipped end to end', 'From first sketch to production, including the parts nobody sees.'],
];
---

<section class="section about" aria-labelledby="about-heading">
  <div class="section__inner">
    <div class="about__grid">
      <div>
        <p class="eyebrow">01&nbsp; About</p>
        <h2 id="about-heading" class="section__heading is-left"><span class="heading-text">ABOUT ME</span></h2>
        <p class="sub">Ten years building for the web, <em>mostly in React.</em></p>
        <p class="lede">
          {words.map((w, i) => (
            <>
              <span class="w" style={`--a: ${Math.round((i / words.length) * 60)}%`}>{w}</span>{' '}
            </>
          ))}
        </p>
      </div>

      <aside class="now" aria-labelledby="now-heading">
        <p class="now__head"><b id="now-heading">Now</b><span>{nowDate}</span></p>
        <dl>
          {now.map(([term, text], i) => (
            <>
              <dt style={`--i: ${i}`}>{term}</dt>
              <dd style={`--i: ${i}`}>{text}</dd>
            </>
          ))}
        </dl>
      </aside>
    </div>

    <ol class="steps" role="list">
      {steps.map(([title, text], i) => (
        <li style={`--i: ${i}`}>
          <b aria-hidden="true">
            <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="22" pathLength="1"></circle></svg>
            {i + 1}
          </b>
          <div>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about {
    background: var(--ebony-clay);
  }

  .about__grid {
    display: grid;
    gap: 56px;
  }

  .now {
    position: relative;
    align-self: start;
    padding: 6px 0 6px 28px;
  }

  /* The rule down the left, drawn as the panel comes up */
  .now::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--cyan);
    transform-origin: 50% 0;
  }

  .now__head {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .now__head b {
    font: 700 56px/1 var(--font-display);
    letter-spacing: 0.5px;
    color: var(--ink);
  }

  .now__head span {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8792b3;
  }

  dl {
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: 100px 1fr;
    row-gap: 18px;
  }

  dt {
    font: 700 12px/1.9 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  dd {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink);
  }

  .steps {
    display: grid;
    gap: 32px;
    margin: 80px 0 0;
    padding: 50px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .steps li {
    display: flex;
    gap: 20px;
  }

  .steps b {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    font: 700 17px var(--font-body);
    color: var(--accent);
  }

  .steps svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .steps circle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 1;
  }

  /* Scroll choreography */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lede {
        view-timeline: --lede block;
      }
      .w {
        animation: light-up linear both;
      }
      .about .w {
        animation-timeline: --lede;
        animation-range: cover calc(18% + var(--a)) cover calc(26% + var(--a));
      }

      .now::before {
        animation: draw-y linear both;
      }
      .about .now::before {
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
      dt,
      dd {
        animation: fade-rise linear both;
      }
      .now dt,
      .now dd {
        animation-timeline: --now;
        animation-range: entry calc(30% + var(--i) * 15%) cover calc(30% + var(--i) * 6%);
      }
      .now {
        view-timeline: --now block;
      }

      .steps li {
        animation: fade-rise linear both;
      }
      .steps circle {
        animation: draw-ring linear both;
      }
      .about .steps li {
        animation-timeline: view();
        animation-range: entry calc(var(--i) * 15%) cover calc(25% + var(--i) * 5%);
      }
      .about .steps circle {
        animation-timeline: --steps;
        animation-range: cover calc(20% + var(--i) * 8%) cover calc(45% + var(--i) * 8%);
      }
      .steps {
        view-timeline: --steps block;
      }
    }
  }

  @keyframes light-up {
    from {
      color: rgb(154 163 189 / 0.28);
    }
    to {
      color: #c9cfe2;
    }
  }

  @keyframes draw-y {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes draw-ring {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  h3 {
    font: 700 20px var(--font-body);
    color: var(--ink);
  }

  .steps p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 90px;
    }
    .now {
      margin-top: 46px;
      padding-left: 34px;
    }
    .now__head b {
      font-size: 64px;
    }
    dl {
      grid-template-columns: 110px 1fr;
    }
    dd {
      font-size: 19px;
    }
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }
</style>
