---
// What Rodney is doing now. Update it when it changes.
const nowDate = 'November 2026';
const now = [
  ['Building', 'SmartCompare, so New Zealanders stop overpaying for their mobile plan', 'stack'],
  ['Shipping', 'Whole-site audits for SEO Lamp', 'score'],
  ['Learning', 'Swift and SwiftUI, for the Immerse reader', 'pen'],
  ['Based', 'New Zealand', 'pin'],
];
// The intro lights up word by word as it scrolls through the view
const intro =
  "Hey, I'm Rodney, a senior frontend developer in New Zealand. I've spent more than ten years building fast, polished interfaces, and lately I've been designing, building and shipping my own products end to end.";
const words = intro.split(' ');
const steps = [
  ['Fast by default', 'Static where it can be, light on JavaScript, quick on a slow phone.'],
  ['Details that feel right', 'Spacing, motion and states that make an interface feel considered.'],
  ['Shipped end to end', 'From first sketch to production, including the parts nobody sees.'],
];
---

<section class="section about" aria-labelledby="about-heading">
  <div class="section__inner">
    <div class="about__grid">
      <div>
        <p class="eyebrow"><span class="num" style="--to: 1" aria-hidden="true"></span>&nbsp; About</p>
        <h2 id="about-heading" class="section__heading is-left"><span class="heading-text">ABOUT ME</span></h2>
        <p class="sub">Ten years building for the web, <em>mostly in React.</em></p>
        <p class="lede">
          {words.map((w, i) => (
            <>
              <span class="w" style={`--a: ${Math.round((i / words.length) * 60)}%`}>{w}</span>{' '}
            </>
          ))}
        </p>
      </div>

      <aside class="now" aria-labelledby="now-heading" data-live>
        <p class="now__head"><b id="now-heading">Now</b><span>{nowDate}</span></p>
        <dl>
          {now.map(([term, text, icon], i) => (
            <>
              <dt style={`--i: ${i}`}>{term}</dt>
              <dd style={`--i: ${i}`}>
                <span class:list={['ico', 'loop', `ico--${icon}`]} aria-hidden="true">
                  {icon === 'stack' && <><i></i><i></i><i></i></>}
                  {icon === 'score' && <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="8" pathLength="1"></circle><circle cx="10" cy="10" r="8" pathLength="1"></circle><path d="M6.5 10.3l2.3 2.3 4.7-4.9" pathLength="1"></path></svg>}
                  {icon === 'pen' && <svg viewBox="0 0 20 20"><path d="M2 14c3-6 5-9 7-6s-2 7 1 7 5-9 8-10" pathLength="1"></path></svg>}
                  {icon === 'pin' && <><i></i><i></i></>}
                </span>
                <span>{text}</span>
              </dd>
            </>
          ))}
        </dl>
      </aside>
    </div>

    <ol class="steps" role="list" data-live>
      {steps.map(([title, text], i) => (
        <li style={`--i: ${i}`}>
          <b aria-hidden="true">
            <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="22" pathLength="1"></circle></svg>
            {i + 1}
          </b>
          <div>
            <h3>{title}</h3>
            <p>{text}</p>
            {i === 0 && <p class="mini loop mini--fast" aria-hidden="true"><span><i></i></span><small>0.4s</small></p>}
            {i === 1 && <p class="mini loop mini--grid" aria-hidden="true"><i></i><i></i><i></i><i></i></p>}
            {i === 2 && <p class="mini loop mini--ship" aria-hidden="true"><span>Sketch</span><span>Code</span><span>Live</span></p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about {
    background: var(--ebony-clay);
  }

  .about__grid {
    display: grid;
    gap: 56px;
  }

  .now {
    position: relative;
    align-self: start;
    padding: 6px 0 6px 28px;
  }

  /* The rule down the left, drawn as the panel comes up */
  .now::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--cyan);
    transform-origin: 50% 0;
  }

  .now__head {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .now__head b {
    font: 700 56px/1 var(--font-display);
    letter-spacing: 0.5px;
    color: var(--ink);
  }

  .now__head span {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8792b3;
  }

  dl {
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: 100px 1fr;
    row-gap: 18px;
  }

  dt {
    font: 700 12px/1.9 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  dd {
    display: flex;
    gap: 12px;
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink);
  }

  /* Tiny live icons, one per row */
  .ico {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 4px;
  }

  .ico svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Building: blocks stack up and settle */
  .ico--stack i {
    position: absolute;
    left: 2px;
    right: 2px;
    height: 5px;
    border-radius: 2px;
    background: var(--accent);
    animation: stack 3.2s cubic-bezier(0.3, 1.4, 0.5, 1) infinite;
  }
  .ico--stack i:nth-child(1) {
    bottom: 1px;
    opacity: 0.45;
  }
  .ico--stack i:nth-child(2) {
    bottom: 7px;
    left: 4px;
    right: 4px;
    opacity: 0.7;
    animation-delay: 0.25s;
  }
  .ico--stack i:nth-child(3) {
    bottom: 13px;
    left: 6px;
    right: 6px;
    animation-delay: 0.5s;
  }

  @keyframes stack {
    0% {
      transform: translateY(-14px);
      opacity: 0;
    }
    18%,
    85% {
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  /* Shipping: a score ring fills, then a tick */
  .ico--score circle {
    fill: none;
    stroke-width: 2;
    stroke: rgb(127 220 245 / 0.2);
  }
  .ico--score circle + circle,
  .ico--score path {
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-dasharray: 1;
    animation: score 3.6s ease-out infinite;
  }
  .ico--score circle + circle {
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
  }
  .ico--score path {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    animation-name: tick;
  }

  @keyframes score {
    0% {
      stroke-dashoffset: 1;
    }
    45%,
    100% {
      stroke-dashoffset: 0.02;
    }
  }

  @keyframes tick {
    0%,
    45% {
      stroke-dashoffset: 1;
    }
    60%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  /* Learning: a pen line writes itself */
  .ico--pen path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 1;
    animation: write 4s ease-in-out infinite;
  }

  @keyframes write {
    0% {
      stroke-dashoffset: 1;
    }
    55%,
    80% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -1;
    }
  }

  /* Based: a location dot with a ripple */
  .ico--pin i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--accent);
  }
  .ico--pin i + i {
    background: none;
    border: 1.5px solid var(--accent);
    animation: ripple 2.4s ease-out infinite;
  }

  @keyframes ripple {
    from {
      transform: scale(1);
      opacity: 0.9;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* Principle demos */
  .mini {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 22px;
    margin-top: 14px;
    font-size: 12px;
    color: #8792b3;
  }

  /* Fast: a load bar races to full */
  .mini--fast span {
    flex: 1;
    max-width: 160px;
    height: 4px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.08);
    overflow: hidden;
  }
  .mini--fast i {
    display: block;
    height: 100%;
    border-radius: 4px;
    background: var(--accent);
    transform-origin: 0 50%;
    animation: race 3s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }

  @keyframes race {
    0% {
      transform: scaleX(0);
    }
    30%,
    90% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }

  /* Details: loose blocks snap into a tidy row */
  .mini--grid i {
    width: 22px;
    height: 12px;
    border-radius: 3px;
    border: 1px solid rgb(127 220 245 / 0.55);
    animation: snap 3.4s cubic-bezier(0.3, 1.5, 0.5, 1) infinite;
  }
  .mini--grid i:nth-child(1) {
    --dx: -3px;
    --dy: 4px;
  }
  .mini--grid i:nth-child(2) {
    --dx: 4px;
    --dy: -5px;
    animation-delay: 0.08s;
  }
  .mini--grid i:nth-child(3) {
    --dx: -2px;
    --dy: 6px;
    animation-delay: 0.16s;
  }
  .mini--grid i:nth-child(4) {
    --dx: 5px;
    --dy: -3px;
    animation-delay: 0.24s;
  }

  @keyframes snap {
    0%,
    20% {
      transform: translate(var(--dx), var(--dy)) rotate(4deg);
    }
    45%,
    100% {
      transform: none;
    }
  }

  /* Shipped: a highlight walks from sketch to code to live */
  .mini--ship span {
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.1);
    animation: step 4.5s steps(1) infinite;
  }
  .mini--ship span:nth-child(2) {
    animation-delay: 1.5s;
  }
  .mini--ship span:nth-child(3) {
    animation-delay: 3s;
  }

  @keyframes step {
    0% {
      border-color: var(--accent);
      color: var(--accent);
    }
    33% {
      border-color: rgb(255 255 255 / 0.1);
      color: #8792b3;
    }
  }

  .steps {
    display: grid;
    gap: 32px;
    margin: 80px 0 0;
    padding: 50px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .steps li {
    display: flex;
    gap: 20px;
  }

  .steps b {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    font: 700 17px var(--font-body);
    color: var(--accent);
  }

  .steps svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .steps circle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 1;
  }

  /* Scroll choreography */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lede {
        view-timeline: --lede block;
      }
      .w {
        animation: light-up linear both;
      }
      .about .w {
        animation-timeline: --lede;
        animation-range: cover calc(18% + var(--a)) cover calc(26% + var(--a));
      }

      .now::before {
        animation: draw-y linear both;
      }
      .about .now::before {
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
      dt,
      dd {
        animation: fade-rise linear both;
      }
      .now dt,
      .now dd {
        animation-timeline: --now;
        animation-range: entry calc(30% + var(--i) * 15%) cover calc(30% + var(--i) * 6%);
      }
      .now {
        view-timeline: --now block;
      }

      .steps li {
        animation: fade-rise linear both;
      }
      .steps circle {
        animation: draw-ring linear both;
      }
      .about .steps li {
        animation-timeline: view();
        animation-range: entry calc(var(--i) * 15%) cover calc(25% + var(--i) * 5%);
      }
      .about .steps circle {
        animation-timeline: --steps;
        animation-range: cover calc(20% + var(--i) * 8%) cover calc(45% + var(--i) * 8%);
      }
      .steps {
        view-timeline: --steps block;
      }
    }
  }

  @keyframes light-up {
    from {
      color: rgb(154 163 189 / 0.28);
    }
    to {
      color: #c9cfe2;
    }
  }

  @keyframes draw-y {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes draw-ring {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  h3 {
    font: 700 20px var(--font-body);
    color: var(--ink);
  }

  .steps p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 90px;
    }
    .now {
      margin-top: 46px;
      padding-left: 34px;
    }
    .now__head b {
      font-size: 64px;
    }
    dl {
      grid-template-columns: 110px 1fr;
    }
    dd {
      font-size: 19px;
    }
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }
</style>
