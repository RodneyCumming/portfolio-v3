---
import Odo from './Odo.astro';
// What Rodney is doing now. Update it when it changes.
const nowDate = 'November 2026';
const now = [
  ['Building', 'SmartCompare, a site comparing NZ mobile plans', 'blocks'],
  ['Working on', 'Site audits for SEO Lamp', 'parcel'],
  ['Learning', 'Swift, for an audiobook reader app', 'sprout'],
  ['Based', 'New Zealand', 'drop'],
];
// The intro lights up word by word as it scrolls through the view
const intro =
  "Hi, I'm Rodney. I'm a frontend developer in New Zealand and I've been doing it for a bit over ten years. In my spare time I make small sites and apps of my own, and a few of them are further down.";
const words = intro.split(' ');
const steps = [
  ['Quick to load', "I keep sites light so they're fast, even on a slow phone."],
  ['The small details', 'I like getting the spacing, motion and little states right.'],
  ['All of it', 'I enjoy doing the whole thing, from the first sketch to putting it live.'],
];
---

<section class="section about" aria-labelledby="about-heading">
  <div class="section__inner">
    <div class="about__grid">
      <div>
        <p class="eyebrow" data-live><Odo value="01" />&nbsp; About</p>
        <h2 id="about-heading" class="section__heading is-left"><span class="heading-text">ABOUT ME</span></h2>
        <p class="sub">I build websites, <em>mostly with React.</em></p>
        <p class="lede">
          {words.map((w, i) => (
            <>
              <span class="w" style={`--a: ${Math.round((i / words.length) * 60)}%`}>{w}</span>{' '}
            </>
          ))}
        </p>
      </div>

      <aside class="now" aria-labelledby="now-heading" data-live>
        <p class="now__head"><b id="now-heading">Now</b><span>{nowDate}</span></p>
        <dl>
          {now.map(([term, text, icon], i) => (
            <>
              <dt style={`--i: ${i}`}>{term}</dt>
              <dd style={`--i: ${i}`}>
                <span class:list={['ico', `ico--${icon}`]} aria-hidden="true" style={`--dd: ${0.2 + i * 0.25}s`}>
                  {icon === 'blocks' && (
                    <svg class="draw" viewBox="0 0 24 24">
                      <rect x="3" y="14" width="8" height="7" rx="1.5" pathLength="1"></rect>
                      <rect x="13" y="14" width="8" height="7" rx="1.5" pathLength="1"></rect>
                      <rect x="8" y="5" width="8" height="7" rx="1.5" pathLength="1"></rect>
                    </svg>
                  )}
                  {icon === 'parcel' && (
                    <svg class="draw" viewBox="0 0 24 24">
                      <path d="M3.5 8 12 3.5 20.5 8v8L12 20.5 3.5 16z" pathLength="1"></path>
                      <path d="M3.5 8 12 12.5 20.5 8M12 12.5v8" pathLength="1"></path>
                    </svg>
                  )}
                  {icon === 'sprout' && (
                    <svg class="sprout loop" viewBox="0 0 24 24">
                      <g class="sprout__plant">
                        <path class="sprout__stem" d="M12 22c0-5-.4-8 1.2-12.5" pathLength="1"></path>
                        <path class="sprout__leaf l1" d="M12.4 15.5c-2.2-.3-4.6-2-5-4.6 2.5 0 4.6 1.7 5 4.6z"></path>
                        <path class="sprout__leaf l2" d="M12.8 12.2c1.6-1.3 4.1-2.1 6.2-1.3-1.3 2.1-3.7 2.5-6.2 1.3z"></path>
                      </g>
                    </svg>
                  )}
                  {icon === 'drop' && (
                    <span class="drop loop"><b></b><i></i><i></i></span>
                  )}
                </span>
                <span>{text}</span>
              </dd>
            </>
          ))}
        </dl>
      </aside>
    </div>

    <ol class="steps" role="list" data-live>
      {steps.map(([title, text], i) => (
        <li style={`--i: ${i}`}>
          <b aria-hidden="true">
            <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="22" pathLength="1"></circle></svg>
            {i + 1}
          </b>
          <div>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about {
    background: var(--ebony-clay);
  }

  .about__grid {
    display: grid;
    gap: 56px;
  }

  .now {
    position: relative;
    align-self: start;
    padding: 6px 0 6px 28px;
  }

  /* The rule down the left, drawn as the panel comes up */
  .now::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--cyan);
    transform-origin: 50% 0;
  }

  .now__head {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .now__head b {
    font: 700 56px/1 var(--font-display);
    letter-spacing: 0.5px;
    color: var(--ink);
  }

  .now__head span {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8792b3;
  }

  dl {
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: 100px 1fr;
    row-gap: 18px;
  }

  dt {
    font: 700 12px/1.9 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  dd {
    display: flex;
    gap: 12px;
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink);
  }

  /* Small icons, one per row: line drawings that draw themselves, a sprout
     that grows and sways, and a drop with its ripple */
  .ico {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 4px;
    color: var(--accent);
  }

  .ico svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .draw :is(path, rect) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sprout__stem {
    fill: none;
    stroke: #7fd6a8;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 1;
    animation: grow 9s ease-out infinite;
  }

  .sprout__leaf {
    fill: #5fbf8f;
    transform-box: fill-box;
    animation: unfurl 9s ease-out infinite;
  }

  .sprout__leaf.l1 {
    transform-origin: 100% 100%;
  }

  .sprout__leaf.l2 {
    transform-origin: 0 100%;
    animation-delay: 0.4s;
  }

  .sprout__plant {
    transform-origin: 12px 22px;
    animation: breeze 4.5s ease-in-out infinite alternate;
  }

  @keyframes grow {
    0% {
      stroke-dashoffset: 1;
    }
    25%,
    92% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  @keyframes unfurl {
    0%,
    18% {
      transform: scale(0);
    }
    34%,
    92% {
      transform: scale(1);
    }
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }

  @keyframes breeze {
    from {
      transform: rotate(-5deg);
    }
    to {
      transform: rotate(5deg);
    }
  }

  .drop {
    position: absolute;
    inset: 0;
  }

  .drop b {
    position: absolute;
    left: 50%;
    top: 0;
    width: 5px;
    height: 7px;
    margin-left: -2.5px;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: var(--accent);
    animation: fall 4s cubic-bezier(0.5, 0, 1, 1) infinite;
  }

  .drop i {
    position: absolute;
    left: 50%;
    top: 70%;
    width: 10px;
    height: 4px;
    margin: -2px 0 0 -5px;
    border-radius: 50%;
    border: 1.3px solid var(--accent);
    opacity: 0;
    animation: ring 4s ease-out infinite;
  }

  .drop i + i {
    animation-delay: 0.45s;
  }

  @keyframes fall {
    0% {
      transform: translateY(-6px);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    26% {
      transform: translateY(10px);
      opacity: 1;
    }
    27%,
    100% {
      transform: translateY(10px);
      opacity: 0;
    }
  }

  @keyframes ring {
    0%,
    26% {
      transform: scale(0.4);
      opacity: 0;
    }
    30% {
      opacity: 0.9;
    }
    80%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }


  .steps {
    display: grid;
    gap: 32px;
    margin: 80px 0 0;
    padding: 50px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .steps li {
    display: flex;
    gap: 20px;
  }

  .steps b {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    font: 700 17px var(--font-body);
    color: var(--accent);
  }

  .steps svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .steps circle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 1;
  }

  /* Scroll choreography */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lede {
        view-timeline: --lede block;
      }
      .w {
        animation: light-up linear both;
      }
      .about .w {
        animation-timeline: --lede;
        animation-range: cover calc(18% + var(--a)) cover calc(26% + var(--a));
      }

      .now::before {
        animation: draw-y linear both;
      }
      .about .now::before {
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
      dt,
      dd {
        animation: fade-rise linear both;
      }
      .now dt,
      .now dd {
        animation-timeline: --now;
        animation-range: entry calc(30% + var(--i) * 15%) cover calc(30% + var(--i) * 6%);
      }
      .now {
        view-timeline: --now block;
      }

      .steps li {
        animation: fade-rise linear both;
      }
      .steps circle {
        animation: draw-ring linear both;
      }
      .about .steps li {
        animation-timeline: view();
        animation-range: entry calc(var(--i) * 15%) cover calc(25% + var(--i) * 5%);
      }
      .about .steps circle {
        animation-timeline: --steps;
        animation-range: cover calc(20% + var(--i) * 8%) cover calc(45% + var(--i) * 8%);
      }
      .steps {
        view-timeline: --steps block;
      }
    }
  }

  @keyframes light-up {
    from {
      color: rgb(154 163 189 / 0.28);
    }
    to {
      color: #c9cfe2;
    }
  }

  @keyframes draw-y {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes draw-ring {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  h3 {
    font: 700 20px var(--font-body);
    color: var(--ink);
  }

  .steps p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 90px;
    }
    .now {
      margin-top: 46px;
      padding-left: 34px;
    }
    .now__head b {
      font-size: 64px;
    }
    dl {
      grid-template-columns: 126px 1fr;
    }
    dd {
      font-size: 19px;
    }
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }
</style>
