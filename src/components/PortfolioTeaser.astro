---
import { Image } from 'astro:assets';
import stack from '../assets/portfolioImage.png';
import Ridge from './Ridge.astro';
---

<section class="section teaser" aria-labelledby="teaser-heading">
  <Ridge color="var(--ebony-clay)" seed={23} />
  <div class="section__inner teaser__inner">
    <div class="teaser__image reveal">
      <Image src={stack} alt="" width={200} loading="lazy" />
    </div>
    <div class="teaser__text reveal">
      <h2 id="teaser-heading" class="section__heading"><span class="heading-text">PORTFOLIO</span></h2>
      <p class="section__body">Check out my portfolio to see some of the projects I have built.</p>
      <a class="button" href="/portfolio">PORTFOLIO</a>
    </div>
  </div>
</section>

<style>
  .teaser {
    background: var(--ebony-clay);
  }

  .teaser__inner {
    display: flex;
    flex-direction: column-reverse;
  }

  .teaser__image {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 4rem;
  }

  .teaser__image img {
    width: 70%;
    max-width: 200px;
    height: auto;
  }

  /* The stack of pages hovers, with its shadow breathing beneath it */
  @media (prefers-reduced-motion: no-preference) {
    .teaser__image img {
      animation: hover-stack 6s ease-in-out infinite;
    }
    .teaser__image::after {
      animation: hover-shadow 6s ease-in-out infinite;
    }
  }

  .teaser__image {
    position: relative;
  }

  .teaser__image::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -18px;
    width: min(56%, 160px);
    height: 14px;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.35), transparent);
    pointer-events: none;
  }

  @keyframes hover-stack {
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes hover-shadow {
    50% {
      scale: 0.8;
      opacity: 0.6;
    }
  }

  .teaser__text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .button {
    margin-top: 40px;
  }

  @media (min-width: 1025px) {
    .teaser__inner {
      flex-direction: row;
      gap: 10vw;
    }
    .teaser__image {
      width: 35%;
      margin-top: 0;
    }
    .teaser__text {
      width: 65%;
      align-items: flex-start;
    }
    .teaser__text .section__heading,
    .teaser__text .section__body {
      text-align: left;
    }
  }
</style>
