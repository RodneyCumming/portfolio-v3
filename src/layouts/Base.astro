---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rodney Cumming - Developer',
  description = "I'm Rodney Cumming, a frontend developer in New Zealand. This is my personal site, with a few things I've made.",
} = Astro.props;
// The build writes index.html and 404.html; the live URLs have no .html
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#203244" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/hn-condensed-bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <slot name="head" />
    <!-- Prerender a page as soon as a link to it is hovered, so clicks are instant -->
    <script type="speculationrules" is:inline>
      {
        "prerender": [{ "where": { "href_matches": "/*" }, "eagerness": "moderate" }]
      }
    </script>
    <!-- Home hero intro: once per visit, set before first paint so nothing flashes -->
    <script is:inline>
      try {
        if (location.pathname === '/' && !sessionStorage.getItem('intro-seen')) {
          document.documentElement.classList.add('intro');
          sessionStorage.setItem('intro-seen', '1');
        }
      } catch (e) {}
    </script>
    <!-- Old links used #/portfolio and #/contact: send them to those sections -->
    <script is:inline>
      if (location.hash.startsWith('#/')) {
        var p = location.hash.slice(1);
        if (p === '/portfolio' || p === '/contact') location.replace('/#' + p.slice(1));
      }
    </script>
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Small ambient animations run only while their element is on screen:
         [data-live] gets .is-live in view (CSS pauses the rest) and .was-seen
         once, for one-off moments like typing -->
    <script is:inline>
      (function () {
        if (!window.IntersectionObserver) return;
        document.documentElement.classList.add('live-ready');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            e.target.classList.toggle('is-live', e.isIntersecting);
            if (e.isIntersecting && !e.target.classList.contains('was-seen')) {
              e.target.classList.add('was-seen');
              e.target.dispatchEvent(new CustomEvent('seen'));
            }
          });
        }, { threshold: 0.3 });
        document.querySelectorAll('[data-live]').forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
